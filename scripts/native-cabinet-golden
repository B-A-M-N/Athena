#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
system_python="${ATHENA_RELEASE_SYSTEM_PYTHON:-python3}"

for command in xvfb-run import identify xdotool; do
  command -v "$command" >/dev/null || {
    printf 'native-cabinet-golden: SKIP — %s is unavailable\n' "$command" >&2
    exit 0
  }
done
if [[ "${NATIVE_CABINET_UPDATE_GOLDEN:-0}" != "1" ]]; then
  command -v compare >/dev/null || {
    printf '%s\n' 'native-cabinet-golden: FAIL — ImageMagick compare is required' >&2
    exit 1
  }
fi

cargo build --release --manifest-path native/Cargo.toml --locked --offline >/dev/null
native_bin="$repo_root/native/target/release/athena-terminal"
golden_path="${NATIVE_CABINET_GOLDEN:-$repo_root/native/assets/athenabox/cabinet-golden.png}"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT
capture_path="$tmp_dir/cabinet.png"

xvfb-run -a -s '-screen 0 1920x1080x24 -ac' \
  env NATIVE_BIN="$native_bin" \
  CAPTURE_PATH="$capture_path" GOLDEN_PATH="$golden_path" \
  ATHENA_RELEASE_SYSTEM_PYTHON="$system_python" \
  bash -c '
    set -euo pipefail
    system_python="${ATHENA_RELEASE_SYSTEM_PYTHON:-python3}"
    wait_for_presentation() {
      PRESENTATION_PATH="$1" MIN_SEQUENCE="$2" EXPECTED_WIDTH="$3" EXPECTED_HEIGHT="$4" "$system_python" - <<'PY'
import json
import os
import time
from pathlib import Path

path = Path(os.environ["PRESENTATION_PATH"])
minimum = int(os.environ["MIN_SEQUENCE"])
width = int(os.environ["EXPECTED_WIDTH"])
height = int(os.environ["EXPECTED_HEIGHT"])
deadline = time.monotonic() + 10.0
while time.monotonic() < deadline:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (FileNotFoundError, OSError, json.JSONDecodeError):
        value = None
    if (
        isinstance(value, dict)
        and int(value.get("presented_frame_sequence", 0)) >= minimum
        and int(value.get("width", 0)) == width
        and int(value.get("height", 0)) == height
    ):
        raise SystemExit(0)
    time.sleep(0.01)
raise SystemExit(f"presentation sync timeout: sequence >= {minimum}, {width}x{height}")
PY
    }
    sync_path="${CAPTURE_PATH%/*}/presentation.json"
    ATHENA_PRESENTATION_CLOCK=fixed ATHENA_NATIVE_PRESENTATION_SYNC="$sync_path" "$NATIVE_BIN" --cabinet-only --no-animations --command "tail -f /dev/null" >/dev/null 2>&1 &
    native_pid=$!
    window="$(timeout 10s xdotool search --sync --name "ATHENA" 2>/dev/null | head -1 || true)"
    [[ -n "$window" ]] || {
      printf "%s\n" "native-cabinet-golden: FAIL — native window did not appear" >&2
      kill "$native_pid" 2>/dev/null || true
      wait "$native_pid" 2>/dev/null || true
      exit 1
    }
    xdotool windowfocus --sync "$window"
    xdotool windowsize --sync "$window" 1280 800
    wait_for_presentation "$sync_path" 1 1280 800
    sequence="$(SYNC_PATH="$sync_path" "$system_python" - <<'PY'
import json
import os
from pathlib import Path

print(json.loads(Path(os.environ["SYNC_PATH"]).read_text())["presented_frame_sequence"])
PY
    )"
    xdotool windowsize --sync "$window" 1672 941
    wait_for_presentation "$sync_path" "$((sequence + 1))" 1672 941
    import -window "$window" "$CAPTURE_PATH"
    kill "$native_pid" 2>/dev/null || true
    wait "$native_pid" 2>/dev/null || true
    [[ "$(identify -format "%wx%h" "$CAPTURE_PATH")" == "1672x941" ]] || {
      printf "%s\n" "native-cabinet-golden: FAIL — capture is not 1672x941" >&2
      exit 1
    }
    if [[ "${NATIVE_CABINET_UPDATE_GOLDEN:-0}" == "1" ]]; then
      mkdir -p "$(dirname "$GOLDEN_PATH")"
      cp "$CAPTURE_PATH" "$GOLDEN_PATH"
    elif [[ -f "$GOLDEN_PATH" ]]; then
      rmse="$(compare -metric RMSE "$GOLDEN_PATH" "$CAPTURE_PATH" null: 2>&1 || true)"
      normalized="$(printf "%s\n" "$rmse" | cut -d "(" -f 2 | cut -d ")" -f 1 | tr -d "[:space:]")"
      awk -v rmse="$normalized" "BEGIN { exit !(rmse != \"\" && rmse <= 0.03) }" || {
        printf "native-cabinet-golden: FAIL — baseline RMSE exceeds tolerance (%s)\n" "$normalized" >&2
        exit 1
      }
    else
      printf "native-cabinet-golden: FAIL — missing approved baseline %s\n" "$GOLDEN_PATH" >&2
      exit 1
    fi
  '

printf 'native-cabinet-golden: PASS — deterministic 1672x941 cabinet baseline (%s)\n' "$golden_path"
