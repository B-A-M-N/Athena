# ---------------------------------------------------------------------------
# Checker
# ---------------------------------------------------------------------------


@dataclass
class Hit:
    rule: str
    path: str
    line: int
    text: str
    severity: str  # "violation" | "info"


def _classify(rule: Rule, rel: str) -> str | None:
    """Return 'info'/'violation' for rel against the rule, or None to skip."""
    if not rel.startswith(rule.include):
        pass
    if not any(rel.startswith(p) for p in rule.include):
        return None
    if any(rel.startswith(p) for p in rule.exclude):
        return None
    if any(rel.startswith(p) for p in rule.allow):
        return "info"
    return "violation"


def _annotated_allow_by_id(line: str, rule_id: str) -> bool:
    """Allow one reviewed physical call site for a named AST rule."""
    return bool(
        re.search(
            rf"#\s*architecture-lint:\s*allow\s+{re.escape(rule_id)}\b",
            line,
            flags=re.IGNORECASE,
        )
    )


def _annotated_allow(rule: Rule, line: str) -> bool:
    """Allow one reviewed physical call site, never an entire file."""
    return bool(
        re.search(
            rf"#\s*architecture-lint:\s*allow\s+{re.escape(rule.id)}\b",
            line,
            flags=re.IGNORECASE,
        )
    )


def _exception_id(line: str) -> str | None:
    match = EXCEPTION_ID_PATTERN.search(line)
    return match.group(1) if match else None


def _load_exception_catalog(
    root: Path,
) -> tuple[dict[tuple[str, str, str], dict[str, object]], list[Hit]]:
    """Load exact exception sites and reject malformed or duplicate entries."""
    path = root / ARCHITECTURE_EXCEPTION_POLICY
    if not path.exists():
        return {}, []
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        return {}, [
            Hit(
                "architecture-exception-policy",
                ARCHITECTURE_EXCEPTION_POLICY,
                1,
                f"invalid exception policy: {exc}",
                "violation",
            )
        ]
    categories = payload.get("categories") if isinstance(payload, dict) else None
    allowed_categories = set(categories) if isinstance(categories, dict) else set()
    catalog: dict[tuple[str, str, str], dict[str, object]] = {}
    hits: list[Hit] = []
    rule_names = {
        "subprocess": "subprocess-outside-approved-backends",
        "raw_database": "raw-db-outside-state",
    }
    if not isinstance(payload, dict) or payload.get("schema") != 2:
        return {}, [
            Hit(
                "architecture-exception-policy",
                ARCHITECTURE_EXCEPTION_POLICY,
                1,
                "exception policy must declare schema 2",
                "violation",
            )
        ]
    for group, rule_name in rule_names.items():
        entries = payload.get(group)
        if not isinstance(entries, list):
            hits.append(
                Hit(
                    "architecture-exception-policy",
                    ARCHITECTURE_EXCEPTION_POLICY,
                    1,
                    f"exception policy group {group!r} must be a list",
                    "violation",
                )
            )
            continue
        for index, entry in enumerate(entries, start=1):
            path_value = entry.get("path") if isinstance(entry, dict) else None
            exception_id = entry.get("id") if isinstance(entry, dict) else None
            line_value = entry.get("line") if isinstance(entry, dict) else None
            category = entry.get("category") if isinstance(entry, dict) else None
            rationale = entry.get("rationale") if isinstance(entry, dict) else None
            model_reachable = entry.get("model_reachable") if isinstance(entry, dict) else None
            authority_boundary = (
                entry.get("authority_boundary") if isinstance(entry, dict) else None
            )
            classification_valid = True
            if group == "subprocess":
                classification_valid = (
                    isinstance(model_reachable, bool)
                    and (
                        (category == "model_reachable_data_plane" and model_reachable)
                        or (category == "trusted_control_plane" and not model_reachable)
                    )
                    and (
                        not model_reachable
                        or (
                            isinstance(authority_boundary, str) and bool(authority_boundary.strip())
                        )
                    )
                )
            valid = (
                isinstance(path_value, str)
                and path_value.startswith(f"{SRC}/")
                and isinstance(exception_id, str)
                and bool(re.fullmatch(r"[a-z0-9][a-z0-9_-]*", exception_id))
                and isinstance(line_value, int)
                and not isinstance(line_value, bool)
                and line_value > 0
                and isinstance(category, str)
                and category in allowed_categories
                and isinstance(rationale, str)
                and bool(rationale.strip())
                and classification_valid
            )
            key = (rule_name, str(path_value), str(exception_id or ""))
            if not valid or key in catalog:
                hits.append(
                    Hit(
                        "architecture-exception-policy",
                        ARCHITECTURE_EXCEPTION_POLICY,
                        index,
                        f"invalid or duplicate {group} exception entry",
                        "violation",
                    )
                )
                continue
            catalog[key] = dict(entry)
    return catalog, hits


def _broad_exception_hits(root: Path, path: Path, rel: str, text: str) -> list[Hit]:
    """Require a reviewable rationale or a hash-pinned legacy rationale.

    The hash pin makes the legacy catalog fail closed when a file changes: a
    new broad catch must carry an inline ``broad-exception:`` rationale before
    the architecture lane can pass.
    """
    if rel.split("/", 1)[0] not in BROAD_EXCEPTION_ROOTS:
        return []
    try:
        policy = json.loads((root / BROAD_EXCEPTION_POLICY).read_text(encoding="utf-8"))
    except (OSError, TypeError, ValueError):
        policy = {}
    files = policy.get("files") if isinstance(policy, dict) else {}
    entry = files.get(f"{SRC}/{rel}") if isinstance(files, dict) else None
    digest = hashlib.sha256(text.encode("utf-8")).hexdigest()
    legacy_ok = isinstance(entry, dict) and entry.get("sha256") == digest
    try:
        tree = ast.parse(text, filename=str(path))
    except SyntaxError as exc:
        return [
            Hit("broad-exception-rationale", f"{SRC}/{rel}", exc.lineno or 1, str(exc), "violation")
        ]
    hits: list[Hit] = []
    lines = text.splitlines()
    for node in ast.walk(tree):
        if not isinstance(node, ast.ExceptHandler):
            continue
        broad = node.type is None or (
            isinstance(node.type, ast.Name) and node.type.id in {"Exception", "BaseException"}
        )
        if not broad:
            continue
        line = lines[node.lineno - 1] if 0 < node.lineno <= len(lines) else ""
        if re.search(r"broad-exception:|rationale:|noqa:\s*BLE001", line, re.IGNORECASE):
            continue
        if legacy_ok:
            hits.append(
                Hit(
                    "broad-exception-rationale",
                    f"{SRC}/{rel}",
                    node.lineno,
                    "hash-pinned legacy catch: " + str(entry.get("rationale")),
                    "info",
                )
            )
        else:
            hits.append(
                Hit(
                    "broad-exception-rationale",
                    f"{SRC}/{rel}",
                    node.lineno,
                    "broad catch requires inline rationale or updated hash-pinned policy entry",
                    "violation",
                )
            )
    return hits


def _package_names(src_dir: Path) -> set[str]:
    return {path.name for path in src_dir.iterdir() if path.is_dir() and any(path.glob("*.py"))}


def _athena_imports(tree: ast.AST) -> list[tuple[str, ast.AST, tuple[str, ...]]]:
    """Return absolute Athena imports and their imported private names."""
    imports: list[tuple[str, ast.AST, tuple[str, ...]]] = []
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                if alias.name.startswith("athena."):
                    imports.append((alias.name, node, ()))
        elif isinstance(node, ast.ImportFrom) and node.level == 0 and node.module:
            if node.module.startswith("athena."):
                private_names = tuple(
                    alias.name for alias in node.names if alias.name.startswith("_")
                )
                imports.append((node.module, node, private_names))
    return imports


def _ast_import_hits(
    root: Path,
    path: Path,
    rel: str,
    text: str,
    package_names: set[str],
) -> tuple[list[Hit], set[tuple[str, str]]]:
    """Check import boundaries from parsed syntax, including multiline imports."""
    try:
        tree = ast.parse(text, filename=str(path))
    except SyntaxError as exc:
        return [
            Hit(
                "architecture-import-parse",
                f"{SRC}/{rel}",
                exc.lineno or 1,
                str(exc),
                "violation",
            )
        ], set()

    parts = rel.split("/")
    if len(parts) < 2 or parts[0] not in package_names:
        return [], set()
    source_package = parts[0]
    hits: list[Hit] = []
    edges: set[tuple[str, str]] = set()
    forbidden_targets: dict[str, set[str]] = {
        "state-authority-import": {"kernel", "service", "cli", "api", "acp", "execution"},
        "kernel-interface-import": {"service", "cli", "api", "acp"},
        "interface-authority-import": {"kernel", "capabilities", "models", "execution"},
    }
    for module, node, private_names in _athena_imports(tree):
        module_parts = module.split(".")
        if len(module_parts) < 2 or module_parts[1] not in package_names:
            continue
        target_package = module_parts[1]
        edges.add((source_package, target_package))
        line = getattr(node, "lineno", 1)
        if source_package != target_package:
            private_modules = tuple(part for part in module_parts[2:] if part.startswith("_"))
            private_items = tuple(dict.fromkeys((*private_modules, *private_names)))
            if private_items:
                hits.append(
                    Hit(
                        "cross-package-private-import",
                        f"{SRC}/{rel}",
                        line,
                        f"imports private cross-package names: {', '.join(private_items)}",
                        "violation",
                    )
                )
        if source_package == "protocol" and target_package != "protocol":
            hits.append(
                Hit(
                    "protocol-implementation-import",
                    f"{SRC}/{rel}",
                    line,
                    f"protocol imports implementation package {target_package!r}",
                    "violation",
                )
            )
        if target_package in forbidden_targets.get("state-authority-import", set()):
            if source_package == "state":
                hits.append(
                    Hit(
                        "state-authority-import",
                        f"{SRC}/{rel}",
                        line,
                        f"state imports authority package {target_package!r}",
                        "violation",
                    )
                )
        if (
            source_package == "kernel"
            and target_package in forbidden_targets["kernel-interface-import"]
        ):
            hits.append(
                Hit(
                    "kernel-interface-import",
                    f"{SRC}/{rel}",
                    line,
                    f"kernel imports interface/facade package {target_package!r}",
                    "violation",
                )
            )
        if (
            source_package in {"cli", "api", "acp"}
            and target_package in forbidden_targets["interface-authority-import"]
        ):
            hits.append(
                Hit(
                    "interface-authority-import",
                    f"{SRC}/{rel}",
                    line,
                    f"interface imports authority package {target_package!r}",
                    "violation",
                )
            )
        if source_package == "context" and target_package == "kernel":
            hits.append(
                Hit(
                    "context-kernel-import",
                    f"{SRC}/{rel}",
                    line,
                    "context imports kernel authority",
                    "violation",
                )
            )
        if source_package == "tasks" and target_package == "kernel":
            hits.append(
                Hit(
                    "task-kernel-import",
                    f"{SRC}/{rel}",
                    line,
                    "task lifecycle imports kernel implementation",
                    "violation",
                )
            )
        if module == "athena.capabilities.registry" and "_compile_validator" in private_names:
            hits.append(
                Hit(
                    "schema-private-import",
                    f"{SRC}/{rel}",
                    line,
                    "imports the registry's private schema compiler",
                    "violation",
                )
            )
    return hits, edges


def _strongly_connected_components(
    graph: dict[str, set[str]],
) -> tuple[tuple[str, ...], ...]:
    """Return package cycles as sorted, deterministic strongly connected components."""
    index = 0
    indices: dict[str, int] = {}
    lowlinks: dict[str, int] = {}
    stack: list[str] = []
    on_stack: set[str] = set()
    components: list[tuple[str, ...]] = []

    def visit(node: str) -> None:
        nonlocal index
        indices[node] = lowlinks[node] = index
        index += 1
        stack.append(node)
        on_stack.add(node)
        for target in sorted(graph.get(node, ())):
            if target not in indices:
                visit(target)
                lowlinks[node] = min(lowlinks[node], lowlinks[target])
            elif target in on_stack:
                lowlinks[node] = min(lowlinks[node], indices[target])
        if lowlinks[node] != indices[node]:
            return
        component: list[str] = []
        while True:
            target = stack.pop()
            on_stack.remove(target)
            component.append(target)
            if target == node:
                break
        if len(component) > 1:
            components.append(tuple(sorted(component)))

    for node in sorted(graph):
        if node not in indices:
            visit(node)
    return tuple(sorted(components))


def _dependency_cycles(
    root: Path,
    files: list[Path],
    package_names: set[str],
) -> tuple[tuple[str, ...], ...]:
    graph = {package: set() for package in package_names}
    for path in files:
        rel = str(path.relative_to(root / SRC))
        rel_parts = rel.split("/")
        if len(rel_parts) < 2 or rel_parts[0] not in package_names:
            continue
        try:
            tree = ast.parse(path.read_text(encoding="utf-8", errors="replace"), filename=str(path))
        except (OSError, SyntaxError):
            continue
        source_package = rel_parts[0]
        for module, _node, _private_names in _athena_imports(tree):
            module_parts = module.split(".")
            if len(module_parts) > 1 and module_parts[1] in package_names:
                graph[source_package].add(module_parts[1])
    return _strongly_connected_components(graph)


def _load_dependency_cycles(
    root: Path,
) -> tuple[set[tuple[str, ...]] | None, list[Hit]]:
    path = root / ARCHITECTURE_DEPENDENCY_BASELINE
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        return None, [
            Hit(
                "architecture-cycle-baseline",
                ARCHITECTURE_DEPENDENCY_BASELINE,
                1,
                f"missing or invalid dependency baseline: {exc}",
                "violation",
            )
        ]
    cycles = payload.get("cycles") if isinstance(payload, dict) else None
    if not isinstance(payload, dict) or payload.get("schema") != 1 or not isinstance(cycles, list):
        return None, [
            Hit(
                "architecture-cycle-baseline",
                ARCHITECTURE_DEPENDENCY_BASELINE,
                1,
                "dependency baseline must declare schema 1 and a cycles list",
                "violation",
            )
        ]
    parsed: set[tuple[str, ...]] = set()
    hits: list[Hit] = []
    for line, cycle in enumerate(cycles, start=1):
        valid = (
            isinstance(cycle, list)
            and len(cycle) > 1
            and all(isinstance(item, str) and item for item in cycle)
            and cycle == sorted(set(cycle))
        )
        normalized = tuple(cycle) if isinstance(cycle, list) else ()
        if not valid or normalized in parsed:
            hits.append(
                Hit(
                    "architecture-cycle-baseline",
                    ARCHITECTURE_DEPENDENCY_BASELINE,
                    line,
                    "cycles must be unique, sorted lists containing at least two package names",
                    "violation",
                )
            )
            continue
        parsed.add(normalized)
    return parsed, hits


def _is_allowed_cycle_refinement(
    current: tuple[str, ...],
    accepted: set[tuple[str, ...]],
) -> bool:
    """Return whether a current SCC is equal to or contained by an accepted SCC."""
    current_set = set(current)
    return any(current_set <= set(previous) for previous in accepted)


def _dependency_cycle_hits(
    root: Path,
    files: list[Path],
    package_names: set[str],
) -> list[Hit]:
    baseline, hits = _load_dependency_cycles(root)
    if baseline is None:
        return hits
    current = set(_dependency_cycles(root, files, package_names))
    for cycle in sorted(
        cycle for cycle in current if not _is_allowed_cycle_refinement(cycle, baseline)
    ):
        hits.append(
            Hit(
                "architecture-cycle-baseline",
                ARCHITECTURE_DEPENDENCY_BASELINE,
                1,
                "new package cycle is not in the committed ratchet baseline: " + " -> ".join(cycle),
                "violation",
            )
        )
    retired = sorted(
        cycle
        for cycle in baseline
        if not any(set(current_cycle) <= set(cycle) for current_cycle in current)
    )
    severity = "info" if current else "violation"
    for cycle in retired:
        message_prefix = (
            "retired package cycle: "
            if severity == "info"
            else "completely retired baseline requires a dependency-cycle update: "
        )
        hits.append(
            Hit(
                "architecture-cycle-baseline",
                ARCHITECTURE_DEPENDENCY_BASELINE,
                1,
                message_prefix + " -> ".join(cycle),
                severity,
            )
        )

    reference = _architecture_reference(root)
    if reference:
        previous_text = _git_output(root, "show", f"{reference}:{ARCHITECTURE_DEPENDENCY_BASELINE}")
        if previous_text is not None:
            try:
                previous_payload = json.loads(previous_text)
                previous_cycles = {
                    tuple(cycle)
                    for cycle in previous_payload.get("cycles", [])
                    if isinstance(cycle, list)
                }
            except (TypeError, ValueError, AttributeError):
                previous_cycles = set()
                hits.append(
                    Hit(
                        "architecture-cycle-baseline",
                        ARCHITECTURE_DEPENDENCY_BASELINE,
                        1,
                        "historical dependency baseline is invalid JSON",
                        "violation",
                    )
                )
            for cycle in sorted(
                cycle
                for cycle in baseline
                if baseline and not _is_allowed_cycle_refinement(cycle, previous_cycles)
            ):
                hits.append(
                    Hit(
                        "architecture-cycle-baseline",
                        ARCHITECTURE_DEPENDENCY_BASELINE,
                        1,
                        "dependency cycle baseline cannot be retired without a historical ratchet entry: "
                        + " -> ".join(cycle),
                        "violation",
                    )
                )
    return hits


def _git_output(root: Path, *args: str) -> str | None:
    """Return a git value when this checkout has the requested history."""
    try:
        result = subprocess.run(
            ["git", "-C", str(root), *args],
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError:
        return None
    if result.returncode != 0:
        return None
    return result.stdout.strip()


def _architecture_reference(root: Path) -> str | None:
    """Choose the PR merge-base when available, otherwise the parent commit."""
    requested = os.environ.get("ATHENA_ARCHITECTURE_BASE_REF") or os.environ.get("GITHUB_BASE_REF")
    if requested:
        candidates = [requested]
        if "/" not in requested:
            candidates.append(f"origin/{requested}")
        for candidate in candidates:
            if _git_output(root, "rev-parse", "--verify", f"{candidate}^{{commit}}"):
                merge_base = _git_output(root, "merge-base", "HEAD", candidate)
                if merge_base:
                    return merge_base
    return _git_output(root, "rev-parse", "--verify", "HEAD^{commit}")


def _load_budget_map(value: object, *, label: str) -> tuple[dict[str, int] | None, str | None]:
    if not isinstance(value, dict):
        return None, f"{label} must be an object"
    parsed: dict[str, int] = {}
    for key, raw in value.items():
        if isinstance(raw, bool) or not isinstance(raw, int) or raw <= 0:
            return None, f"{label}.{key} must be a positive integer"
        parsed[str(key)] = raw
    return parsed, None


def _read_baseline_payload(
    payload: str, *, label: str
) -> tuple[dict[str, dict[str, int]] | None, str | None]:
    try:
        value = json.loads(payload)
    except (TypeError, ValueError) as exc:
        return None, f"{label} is not valid JSON: {exc}"
    if not isinstance(value, dict):
        return None, f"{label} must be an object"
    python, error = _load_budget_map(value.get("python"), label=f"{label}.python")
    if error:
        return None, error
    rust, error = _load_budget_map(value.get("rust"), label=f"{label}.rust")
    if error:
        return None, error
    assert python is not None and rust is not None
    result = {"python": python, "rust": rust}
    for key in (
        "python-function-budgets",
        "python-class-budgets",
        "default-callable-lines",
        "default-class-lines",
    ):
        if key in value:
            result[key] = value[key]
    return result, None


def _load_debt_waivers(root: Path) -> tuple[dict[tuple[str, str], dict[str, object]], list[Hit]]:
    path = root / ARCHITECTURE_DEBT_WAIVERS
    if not path.exists():
        return {}, []
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        return {}, [
            Hit(
                "architecture-size-baseline",
                ARCHITECTURE_DEBT_WAIVERS,
                1,
                f"invalid architecture debt waiver file: {exc}",
                "violation",
            )
        ]
    entries = payload.get("waivers") if isinstance(payload, dict) else None
    if not isinstance(entries, list):
        return {}, [
            Hit(
                "architecture-size-baseline",
                ARCHITECTURE_DEBT_WAIVERS,
                1,
                "architecture debt waivers must contain a waivers list",
                "violation",
            )
        ]
    waivers: dict[tuple[str, str], dict[str, object]] = {}
    hits: list[Hit] = []
    for index, entry in enumerate(entries, start=1):
        if not isinstance(entry, dict):
            hits.append(
                Hit(
                    "architecture-size-baseline",
                    ARCHITECTURE_DEBT_WAIVERS,
                    index,
                    "each architecture debt waiver must be an object",
                    "violation",
                )
            )
            continue
        family = entry.get("family")
        module = entry.get("path")
        old_budget = entry.get("old_budget")
        new_budget = entry.get("new_budget")
        rationale = entry.get("rationale")
        key = (str(family), str(module))
        valid = (
            family in {"python", "rust"}
            and isinstance(module, str)
            and bool(module)
            and isinstance(old_budget, int)
            and not isinstance(old_budget, bool)
            and old_budget > 0
            and isinstance(new_budget, int)
            and not isinstance(new_budget, bool)
            and new_budget > old_budget
            and isinstance(rationale, str)
            and bool(rationale.strip())
        )
        if not valid or key in waivers:
            hits.append(
                Hit(
                    "architecture-size-baseline",
                    ARCHITECTURE_DEBT_WAIVERS,
                    index,
                    "waiver must uniquely identify a python/rust path, provide positive old/new budgets with new > old, and include a rationale",
                    "violation",
                )
            )
            continue
        waivers[key] = entry
    return waivers, hits



def _python_size_hits(
    baseline: dict,
    rel: str,
    path,
) -> list[Hit]:
    """AST-based callable/class breadth ratchet for Python source.

    Named hotspot budgets remain exact ratchets.  Every other callable and
    class is subject to generic new-code ceilings so future growth cannot be
    invisible merely because the enclosing module is below its legacy budget.
    """
    try:
        import ast as _ast

        tree = _ast.parse(path.read_text(encoding="utf-8", errors="replace"))
    except (OSError, SyntaxError):
        return []
    function_budgets = (baseline.get("python-function-budgets") or {}).get(rel) or {}
    class_budgets = (baseline.get("python-class-budgets") or {}).get(rel) or {}
    default_callable = int(baseline.get("default-callable-lines", 200))
    default_class = int(baseline.get("default-class-lines", 600))
    hits: list[Hit] = []

    def _check(node, *, kind: str, budget: int) -> None:
        length = (node.end_lineno or node.lineno) - node.lineno
        if length <= budget:
            return
        hits.append(
            Hit(
                f"{kind}-size-budget",
                f"{SRC}/{rel}:{node.lineno}",
                length,
                f"{kind} {node.name}() has {length} lines; budget is {budget}",
                "violation",
            )
        )

    for node in _ast.walk(tree):
        if isinstance(node, (_ast.FunctionDef, _ast.AsyncFunctionDef)):
            _check(
                node,
                kind="function",
                budget=int(function_budgets.get(node.name, default_callable)),
            )
        elif isinstance(node, _ast.ClassDef):
            _check(
                node,
                kind="class",
                budget=int(class_budgets.get(node.name, default_class)),
            )
    return hits


def _budget_widening_hits(
    root: Path, current: dict[str, dict[str, int]], baseline_line: int
) -> list[Hit]:
    """Reject unwaived ceiling increases relative to the PR merge-base."""
    reference = _architecture_reference(root)
    if not reference:
        return []
    previous_text = _git_output(
        root, "show", f"{reference}:{'docs/architecture-size-baseline.json'}"
    )
    if previous_text is None:
        # This is the initial introduction of the baseline, not a widening.
        return []
    previous, error = _read_baseline_payload(
        previous_text, label="historical architecture baseline"
    )
    if error:
        return [
            Hit(
                "architecture-size-baseline",
                "docs/architecture-size-baseline.json",
                1,
                error,
                "violation",
            )
        ]
    assert previous is not None
    waivers, waiver_hits = _load_debt_waivers(root)
    hits = list(waiver_hits)
    seen: set[tuple[str, str]] = set()
    for family in ("python", "rust"):
        old_map = previous[family]
        new_map = current[family]
        for module in sorted(set(old_map) | set(new_map)):
            old_budget = old_map.get(
                module,
                LEGACY_SIZE_BUDGETS.get(module, DEFAULT_MODULE_SIZE_BUDGET)
                if family == "python"
                else RUST_SIZE_BUDGETS.get(module, DEFAULT_RUST_MODULE_SIZE_BUDGET),
            )
            new_budget = new_map.get(
                module,
                LEGACY_SIZE_BUDGETS.get(module, DEFAULT_MODULE_SIZE_BUDGET)
                if family == "python"
                else RUST_SIZE_BUDGETS.get(module, DEFAULT_RUST_MODULE_SIZE_BUDGET),
            )
            if new_budget <= old_budget:
                continue
            key = (family, module)
            seen.add(key)
            waiver = waivers.get(key)
            if (
                waiver is not None
                and waiver.get("old_budget") == old_budget
                and waiver.get("new_budget") == new_budget
            ):
                hits.append(
                    Hit(
                        "architecture-size-baseline",
                        ARCHITECTURE_DEBT_WAIVERS,
                        1,
                        f"waived {family}/{module}: {old_budget} -> {new_budget}",
                        "info",
                    )
                )
                continue
            hits.append(
                Hit(
                    "architecture-size-baseline",
                    "docs/architecture-size-baseline.json",
                    baseline_line,
                    f"{family}/{module} budget widened {old_budget} -> {new_budget}; add an exact waiver with old_budget, new_budget, and rationale",
                    "violation",
                )
            )
    for key in sorted(set(waivers) - seen):
        hits.append(
            Hit(
                "architecture-size-baseline",
                ARCHITECTURE_DEBT_WAIVERS,
                1,
                f"stale architecture debt waiver for {key[0]}/{key[1]}",
                "violation",
            )
        )
    return hits


def scan(root: Path, *, skip_tests: bool = True) -> list[Hit]:
    hits: list[Hit] = []
    exception_catalog, exception_policy_hits = _load_exception_catalog(root)
    hits.extend(exception_policy_hits)
    seen_exception_sites: set[tuple[str, str, str]] = set()
    src_dir = root / SRC
    if not src_dir.is_dir():
        raise SystemExit(f"architecture-lint: {src_dir} not found")

    baseline_path = root / "docs" / "architecture-size-baseline.json"
    try:
        baseline_text = baseline_path.read_text(encoding="utf-8")
    except OSError as exc:
        return [
            Hit(
                "architecture-size-baseline",
                "docs/architecture-size-baseline.json",
                1,
                f"missing or invalid architecture baseline: {exc}",
                "violation",
            )
        ]
    baseline, baseline_error = _read_baseline_payload(baseline_text, label="architecture baseline")
    if baseline_error:
        return [
            Hit(
                "architecture-size-baseline",
                "docs/architecture-size-baseline.json",
                1,
                baseline_error,
                "violation",
            )
        ]
    assert baseline is not None
    hits.extend(_budget_widening_hits(root, baseline, 1))
    python_budgets = dict(LEGACY_SIZE_BUDGETS)
    rust_budgets = dict(RUST_SIZE_BUDGETS)
    python_budgets.update(baseline["python"])
    rust_budgets.update(baseline["rust"])

    files = sorted(p for p in src_dir.rglob("*.py") if not (skip_tests and "/tests/" in str(p)))
    package_names = _package_names(src_dir)
    hits.extend(_dependency_cycle_hits(root, files, package_names))
    for path in files:
        rel = str(path.relative_to(src_dir))
        try:
            line_count = len(path.read_text(encoding="utf-8", errors="replace").splitlines())
        except OSError as exc:
            print(f"architecture-lint: cannot read {path}: {exc}", file=sys.stderr)
            continue
        budget = python_budgets.get(rel, DEFAULT_MODULE_SIZE_BUDGET)
        if line_count > budget:
            hits.append(
                Hit(
                    "module-size-budget",
                    f"{SRC}/{rel}",
                    line_count,
                    f"module has {line_count} lines; budget is {budget}",
                    "violation",
                )
            )
        hits.extend(_python_size_hits(baseline, rel, path))
        active = [(rule, _classify(rule, rel)) for rule in RULES]
        active = [(r, sev) for r, sev in active if sev]
        if not active:
            continue
        text = path.read_text(encoding="utf-8", errors="replace")
        hits.extend(_broad_exception_hits(Path(root), path, rel, text))
        ast_hits, _edges = _ast_import_hits(root, path, rel, text, package_names)
        hits.extend(ast_hits)
        hits.extend(_domain_host_hits(Path(root), path, rel, text))
        for lineno, line in enumerate(text.splitlines(), start=1):
            stripped = line.lstrip()
            if stripped.startswith("#"):
                continue  # comments are documentation, not construction
            for rule, sev in active:
                if rule.id in AST_IMPORT_RULES or rule.id in AST_RULE_IDS:
                    continue
                m = rule.pattern.search(line)
                if not m:
                    continue
                if rule.receiver_filter is not None:
                    window = line[max(0, m.start() - 60) : m.end() + 1]
                    if not rule.receiver_filter.search(window):
                        continue
                severity = "info" if sev == "info" or _annotated_allow(rule, line) else sev
                if severity == "info" and rule.id in {
                    "subprocess-outside-approved-backends",
                    "raw-db-outside-state",
                }:
                    exception_id = _exception_id(line)
                    if exception_id is None:
                        hits.append(
                            Hit(
                                "architecture-exception-policy",
                                f"{SRC}/{rel}",
                                lineno,
                                f"{rule.id} exception site must declare a stable architecture-exception id",
                                "violation",
                            )
                        )
                    site = (rule.id, f"{SRC}/{rel}", exception_id or "")
                    if exception_id is None or site not in exception_catalog:
                        hits.append(
                            Hit(
                                "architecture-exception-policy",
                                f"{SRC}/{rel}",
                                lineno,
                                f"new {rule.id} exception site is not cataloged by stable id",
                                "violation",
                            )
                        )
                    else:
                        seen_exception_sites.add(site)
                hits.append(Hit(rule.id, f"{SRC}/{rel}", lineno, line.strip(), severity))

    native_dir = root / "native" / "src"
    if native_dir.is_dir():
        for path in sorted(native_dir.rglob("*.rs")):
            rel = str(path.relative_to(native_dir))
            try:
                line_count = len(path.read_text(encoding="utf-8", errors="replace").splitlines())
            except OSError as exc:
                print(f"architecture-lint: cannot read {path}: {exc}", file=sys.stderr)
                continue
            budget = rust_budgets.get(rel, DEFAULT_RUST_MODULE_SIZE_BUDGET)
            if line_count > budget:
                hits.append(
                    Hit(
                        "rust-module-size-budget",
                        f"native/src/{rel}",
                        line_count,
                        f"module has {line_count} lines; budget is {budget}",
                        "violation",
                    )
                )
    for site in sorted(set(exception_catalog) - seen_exception_sites):
        rule_name, path_name, exception_id = site
        hits.append(
            Hit(
                "architecture-exception-policy",
                path_name,
                int(exception_catalog[site].get("line", 1)),
                f"stale {rule_name} exception id {exception_id!r} is no longer annotated",
                "violation",
            )
        )
    return hits


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="scripts/architecture-lint",
        description="Scan src/athena for audit-prohibited structural patterns.",
    )
    parser.add_argument(
        "--root", default=str(REPO_ROOT), help="repository root (default: auto-detected)"
    )
    parser.add_argument(
        "--quiet", "-q", action="store_true", help="suppress INFO (allow-listed) lines"
    )
    parser.add_argument("--list-rules", action="store_true", help="print the rule table and exit")
    args = parser.parse_args(argv)

    if args.list_rules:
        for rule in RULES:
            print(f"{rule.id}: {rule.description}")
            print(f"    pattern={rule.pattern.pattern!r}")
            if rule.allow:
                print(f"    allow (INFO)={', '.join(rule.allow)}")
        return 0

    hits = scan(Path(args.root))
    violations = [h for h in hits if h.severity == "violation"]
    infos = [h for h in hits if h.severity == "info"]

    for h in infos:
        if not args.quiet:
            print(f"INFO  [{h.rule}] {h.path}:{h.line}: allow-listed: {h.text}")
    for h in violations:
        print(f"ERROR [{h.rule}] {h.path}:{h.line}: {h.text}")

    if not args.quiet:
        for rule in RULES:
            rule_viol = [h for h in violations if h.rule == rule.id]
            rule_info = [h for h in infos if h.rule == rule.id]
            if rule_viol or rule_info:
                print(
                    f"    {rule.id}: {len(rule_viol)} violation(s), {len(rule_info)} allow-listed"
                )
        print(f"architecture-lint: {len(violations)} violation(s), {len(infos)} allow-listed INFO")
    else:
        print(f"architecture-lint: {len(violations)} violation(s)")

    return 1 if violations else 0


if __name__ == "__main__":
    sys.exit(main())
