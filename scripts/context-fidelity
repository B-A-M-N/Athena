#!/usr/bin/env python3
"""Run the deterministic 50k/100k/250k context-fidelity corpus."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT / "src"))

from athena.evaluation.context_fidelity import (  # noqa: E402
    compact_context,
    large_context_fidelity_corpus,
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", type=Path, default=Path("context-fidelity.json"))
    args = parser.parse_args()
    results = []
    for case in large_context_fidelity_corpus():
        results.append(compact_context(case, rounds=3))
    record = {
        "kind": "athena_context_fidelity_receipt",
        "corpus": ["50k", "100k", "250k"],
        "results": results,
        "status": "PASS" if all(item["passed"] for item in results) else "FAIL",
    }
    args.output.write_text(json.dumps(record, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps(record, sort_keys=True))
    return 0 if record["status"] == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())
