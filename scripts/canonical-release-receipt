#!/usr/bin/env python3
"""Validate that exactly one frozen-clean SHA has a canonical PASS receipt."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import subprocess
import sys


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--evidence-dir", type=Path, required=True)
    parser.add_argument("--sha", default=None)
    args = parser.parse_args()
    try:
        sha = args.sha or subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()
    except (OSError, subprocess.CalledProcessError) as exc:
        print(f"canonical-release-receipt: FAIL — cannot resolve SHA: {exc}", file=sys.stderr)
        return 2
    root = args.evidence_dir.resolve() / sha
    runs = (
        sorted(path for path in root.iterdir() if path.is_dir() and not path.name.startswith("."))
        if root.is_dir()
        else []
    )
    if len(runs) != 1:
        print(
            f"canonical-release-receipt: FAIL — expected exactly one run for {sha}, found {len(runs)}",
            file=sys.stderr,
        )
        return 1
    result_path = runs[0] / "final-release-result.json"
    identity_path = runs[0] / "release-identity.json"
    provenance_path = runs[0] / "release-provenance.json"
    signature_path = runs[0] / "release-provenance.sig"
    if (
        not result_path.is_file()
        or not identity_path.is_file()
        or not provenance_path.is_file()
        or not signature_path.is_file()
        or not signature_path.stat().st_size
    ):
        print(
            "canonical-release-receipt: FAIL — canonical identity/result missing", file=sys.stderr
        )
        return 1
    try:
        result = json.loads(result_path.read_text(encoding="utf-8"))
        identity = json.loads(identity_path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        print(f"canonical-release-receipt: FAIL — invalid receipt: {exc}", file=sys.stderr)
        return 1
    if not (
        result.get("status") == "PASS"
        and result.get("releasable") is True
        and result.get("commit_sha") == sha
        and identity.get("commit_sha") == sha
        and identity.get("skip_e2e") is False
        and result.get("release_run_id") == identity.get("release_run_id")
    ):
        print(
            "canonical-release-receipt: FAIL — receipt is not a full frozen-clean PASS",
            file=sys.stderr,
        )
        return 1
    print(f"canonical-release-receipt: PASS — {sha} run {result['release_run_id']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
