#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
export UV_CACHE_DIR="${UV_CACHE_DIR:-/tmp/athena-uv-cache}"
# This script is invoked directly by the frozen release lane, not inside an
# already-synchronized ``uv run``.  ``--no-sync`` would create an empty
# release venv and make the declared ``build`` dev dependency unavailable.
build_python=("${ATHENA_RELEASE_UV:-uv}" run --frozen --extra dev python)

output_dir="dist"
if [[ "${1:-}" == "--output-dir" ]]; then
  [[ -n "${2:-}" ]] || {
    printf '%s\n' 'build-release-artifacts: --output-dir needs a path' >&2
    exit 2
  }
  output_dir="$2"
fi
mkdir -p "$output_dir"
# A release directory is an exact-artifact boundary. Remove only its direct
# files so an earlier build cannot be mistaken for a publishable artifact.
find "$output_dir" -mindepth 1 -maxdepth 1 -type f -delete
distributions_dir="$output_dir/distributions"
mkdir -p "$distributions_dir"
find "$distributions_dir" -mindepth 1 -maxdepth 1 -type f -delete

# Build every publish artifact once into one immutable directory. Acceptance
# receives these exact paths and the manifest below records their inputs.
scripts/build-native-package --output-dir "$distributions_dir"
# setuptools reuses ``build/`` and can otherwise carry a removed native
# payload from an earlier developer build into the universal wheel.
rm -rf "$repo_root/build"
"${build_python[@]}" -m build --no-isolation --wheel --sdist --outdir "$distributions_dir" .

"${build_python[@]}" - "$output_dir" "$distributions_dir" <<'PY'
import hashlib
import importlib.metadata
import json
import os
import platform
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
import tomllib

out = Path(sys.argv[1]).resolve()
distributions = Path(sys.argv[2]).resolve()
root = Path.cwd()
import sys as _sys
_sys.path.insert(0, str(root / "src"))
from athena.release.native_abi import inspect_native_abi


def run(*args: str) -> str:
    try:
        return subprocess.run(
            args, cwd=root, check=True, capture_output=True, text=True
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError) as exc:
        return f"unavailable: {exc}"


def sha(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


project = tomllib.loads((root / "pyproject.toml").read_text())
native = tomllib.loads((root / "native" / "Cargo.toml").read_text())
native_package = tomllib.loads((root / "native" / "package" / "pyproject.toml").read_text())
source_sha = os.environ.get("ATHENA_RELEASE_SHA") or run("git", "rev-parse", "HEAD")
release_run_id = os.environ.get("ATHENA_RELEASE_RUN_ID", "local")


def canonical_version(value: str) -> str:
    """Map Cargo's prerelease spelling to the wheel/PEP 440 spelling."""
    match = re.fullmatch(r"(\d+\.\d+\.\d+)-(alpha|beta|rc)\.(\d+)", value)
    if match is None:
        return value
    suffix = {"alpha": "a", "beta": "b", "rc": "rc"}[match.group(2)]
    return f"{match.group(1)}{suffix}{match.group(3)}"


python_version = project["project"]["version"]
native_version = native["package"]["version"]
native_package_version = native_package["project"]["version"]
if python_version != native_package_version:
    raise SystemExit(
        "native companion version does not match the Python distribution: "
        f"{native_package_version} != {python_version}"
    )
expected_companion_dependency = f"athena-agent=={python_version}"
if expected_companion_dependency not in native_package["project"].get("dependencies", []):
    raise SystemExit(
        "native companion must depend on the exact Python distribution version: "
        f"{expected_companion_dependency}"
    )
if canonical_version(native_version) != python_version:
    raise SystemExit(
        "native Cargo version does not match the Python distribution: "
        f"{native_version} != {python_version}"
    )
lock_text = (root / "native" / "Cargo.lock").read_text()
lock_data = tomllib.loads(lock_text)
uv_lock_data = tomllib.loads((root / "uv.lock").read_text())
binary_candidates = [path for path in distributions.iterdir() if "native" in path.name and path.suffix == ".whl"]
if not binary_candidates:
    raise SystemExit("native companion wheel is missing before manifest generation")
with __import__("zipfile").ZipFile(binary_candidates[0]) as native_archive:
    binary_members = [
        name
        for name in native_archive.namelist()
        if name.endswith("/athena-terminal") and not name.endswith("/")
    ]
if len(binary_members) != 1:
    raise SystemExit(f"expected one native binary in companion wheel: {binary_members!r}")
with __import__("zipfile").ZipFile(binary_candidates[0]) as native_archive:
    binary_tmp = distributions / ".native-binary"
    binary_tmp.write_bytes(native_archive.read(binary_members[0]))
binary = binary_tmp
schema = (root / "src" / "athena" / "presentation" / "schema.py").read_text()
bridge_version = next(
    line.split("=", 1)[1].strip()
    for line in schema.splitlines()
    if line.startswith("NATIVE_BRIDGE_SCHEMA_VERSION")
)
rustc_details = run("rustc", "-vV")
host = (
    rustc_details.split("host:", 1)[1].splitlines()[0].strip()
    if "host:" in rustc_details
    else platform.machine()
)
artifacts = [
    {
        "path": str(Path("distributions") / path.name),
        "sha256": sha(path),
        "size": path.stat().st_size,
        "commit_sha": source_sha,
        "release_run_id": release_run_id,
    }
    for path in sorted(distributions.iterdir())
    if path.is_file() and path != binary_tmp
]
native_dynamic = run("readelf", "-d", str(binary))
needed = re.findall(r"Shared library: \[([^]]+)\]", native_dynamic)
native_abi = inspect_native_abi(binary)
if native_abi["status"] != "PASS":
    raise SystemExit("native ABI policy failed: " + "; ".join(native_abi["violations"]))
alacritty_match = re.search(
    r'name = "alacritty_terminal"\nversion = "[^"]+"\n'
    r'source = "git\+[^#]+#([0-9a-f]+)"',
    lock_text,
)
sbom_packages = []
cargo_lock_sha256 = sha(root / "native" / "Cargo.lock")
python_lock_path = root / "uv.lock"
python_lock_sha256 = sha(python_lock_path) if python_lock_path.is_file() else "unavailable"


def _license_from_python_metadata(package_name: str) -> tuple[str, dict[str, str]]:
    """Return an SPDX expression plus the metadata provenance for it.

    ``uv.lock`` intentionally records resolution data, not package license
    declarations.  Prefer the standardized PEP 639 field, then the legacy
    metadata field/classifiers.  Packages that are locked for another
    platform may not be installed in this builder; those are explicit
    ``NOASSERTION`` records rather than silently omitted components.
    """
    if _normalized_package_name(package_name) == _normalized_package_name(project["project"]["name"]):
        value = str(project["project"].get("license") or "NOASSERTION")
        return value, {"source": "pyproject.toml", "field": "project.license", "value": value}
    try:
        metadata = importlib.metadata.metadata(package_name)
    except importlib.metadata.PackageNotFoundError:
        return "NOASSERTION", {
            "source": "unavailable",
            "reason": "locked package is not installed for this build platform",
        }
    for field in ("License-Expression", "License"):
        values = [str(value).strip() for value in metadata.get_all(field) or [] if str(value).strip()]
        if values:
            value = values[0]
            if field == "License-Expression":
                return value, {"source": "python-dist-metadata", "field": field, "value": value}
            known = {
                "Apache Software License": "Apache-2.0",
                "Apache Software License 2.0": "Apache-2.0",
                "Apache 2.0": "Apache-2.0",
                "BSD License": "BSD-3-Clause",
                "ISC license": "ISC",
                "ISC License": "ISC",
                "MIT License": "MIT",
                "PSFL": "PSF-2.0",
                "UNKNOWN": "NOASSERTION",
            }
            return known.get(value, value), {
                "source": "python-dist-metadata",
                "field": field,
                "value": value,
            }
    for classifier in metadata.get_all("Classifier") or []:
        if not classifier.startswith("License ::"):
            continue
        label = classifier.split("::")[-1].strip()
        known = {
            "Apache Software License": "Apache-2.0",
            "BSD License": "BSD-3-Clause",
            "GNU Lesser General Public License v3 (LGPLv3)": "LGPL-3.0-only",
            "ISC License": "ISC",
            "MIT License": "MIT",
            "Mozilla Public License 2.0 (MPL 2.0)": "MPL-2.0",
            "Python Software Foundation License": "PSF-2.0",
        }
        return known.get(label, "NOASSERTION"), {
            "source": "python-dist-metadata",
            "field": "Classifier",
            "value": label,
        }
    return "NOASSERTION", {
        "source": "python-dist-metadata",
        "reason": "distribution did not declare a license",
    }


def _source_location(source: object, package_name: str) -> str:
    if isinstance(source, dict):
        for key in ("registry", "git", "url", "path"):
            value = source.get(key)
            if isinstance(value, str) and value:
                return value
        if source.get("editable") == ".":
            return f"https://athena.invalid/source/{source_sha}"
    return f"https://athena.invalid/source/{source_sha}/{package_name}"


def _cargo_license(package_name: str, package_version: str, metadata: dict[tuple[str, str], dict]) -> str:
    package = metadata.get((package_name, package_version), {})
    return str(package.get("license") or "NOASSERTION")


try:
    cargo_metadata = json.loads(
        run("cargo", "metadata", "--manifest-path", "native/Cargo.toml", "--locked", "--offline", "--format-version", "1")
    )
    cargo_license_metadata = {
        (str(package.get("name")), str(package.get("version"))): package
        for package in cargo_metadata.get("packages", [])
        if isinstance(package, dict)
    }
except (json.JSONDecodeError, TypeError, AttributeError):
    cargo_license_metadata = {}


def _normalized_package_name(value: str) -> str:
    return re.split(r"[ <>=!~\[]", value, maxsplit=1)[0].lower().replace("-", "_")


runtime_dependency_names = {
    _normalized_package_name(item) for item in project["project"].get("dependencies", [])
}
optional_dependency_names = {
    group: {_normalized_package_name(item) for item in values}
    for group, values in project["project"].get("optional-dependencies", {}).items()
}
for package_index, package in enumerate(lock_data.get("package", []), 1):
    if not isinstance(package, dict):
        continue
    sbom_package = {
        "SPDXID": "SPDXRef-Cargo-" + str(package_index) + "-" + re.sub(
            r"[^A-Za-z0-9.-]", "-", package["name"] + "-" + package["version"]
        ),
        "name": package["name"],
        "versionInfo": package["version"],
        "downloadLocation": package.get("source", "NOASSERTION"),
        "licenseConcluded": _cargo_license(package["name"], package["version"], cargo_license_metadata),
        "licenseDeclared": _cargo_license(package["name"], package["version"], cargo_license_metadata),
    }
    sbom_package["athena_dependency_scope"] = "native"
    if package.get("checksum"):
        sbom_package["checksums"] = [
            {"algorithm": "SHA256", "checksumValue": package["checksum"]}
        ]
    sbom_packages.append(sbom_package)
python_package_offset = len(sbom_packages)
for package_index, package in enumerate(uv_lock_data.get("package", []), 1):
    if not isinstance(package, dict):
        continue
    source = package.get("source")
    source_url = _source_location(source, package["name"])
    sdist = package.get("sdist")
    if isinstance(sdist, dict) and isinstance(sdist.get("url"), str):
        source_url = sdist["url"]
    elif package.get("wheels") and isinstance(package["wheels"][0], dict):
        wheel_url = package["wheels"][0].get("url")
        if isinstance(wheel_url, str):
            source_url = wheel_url
    license_declared, license_metadata = _license_from_python_metadata(package["name"])
    sbom_package = {
        "SPDXID": "SPDXRef-Python-" + str(package_index) + "-" + re.sub(
            r"[^A-Za-z0-9.-]", "-", package["name"] + "-" + package["version"]
        ),
        "name": package["name"],
        "versionInfo": package["version"],
        "downloadLocation": source_url,
        "licenseConcluded": "NOASSERTION",
        "licenseDeclared": license_declared,
        "athena_license_metadata": license_metadata,
    }
    normalized_name = _normalized_package_name(package["name"])
    if normalized_name == _normalized_package_name(project["project"]["name"]):
        dependency_scope = "project"
    elif normalized_name in runtime_dependency_names:
        dependency_scope = "python-runtime-direct"
    else:
        optional_groups = [
            group
            for group, names in optional_dependency_names.items()
            if normalized_name in names
        ]
        dependency_scope = (
            "python-optional-direct:" + ",".join(sorted(optional_groups))
            if optional_groups
            else "python-transitive"
        )
    sbom_package["athena_dependency_scope"] = dependency_scope
    if isinstance(sdist, dict) and isinstance(sdist.get("hash"), str):
        sbom_package["checksums"] = [
            {"algorithm": "SHA256", "checksumValue": sdist["hash"].removeprefix("sha256:")}
        ]
    elif package.get("wheels"):
        wheel_hash = next(
            (
                wheel.get("hash", "").removeprefix("sha256:")
                for wheel in package["wheels"]
                if isinstance(wheel, dict) and isinstance(wheel.get("hash"), str)
            ),
            "",
        )
        if wheel_hash:
            sbom_package["checksums"] = [
                {"algorithm": "SHA256", "checksumValue": wheel_hash}
            ]
    sbom_packages.append(sbom_package)
native_wheel = next(
    (path for path in distributions.iterdir() if path.name.startswith("athena_agent_native-") and path.suffix == ".whl"),
    None,
)
if native_wheel is None:
    raise SystemExit("native companion wheel is missing from the release artifact directory")
native_license = str(native_package["project"].get("license") or "NOASSERTION")
sbom_packages.append(
    {
        "SPDXID": "SPDXRef-AthenaNativeDistribution",
        "name": native_package["project"]["name"],
        "versionInfo": native_package["project"]["version"],
        "downloadLocation": f"https://athena.invalid/release/{source_sha}/{native_wheel.name}",
        "licenseConcluded": native_license,
        "licenseDeclared": native_license,
        "athena_dependency_scope": "distribution",
        "athena_license_metadata": {
            "source": "native/package/pyproject.toml",
            "field": "project.license",
            "value": native_license,
        },
        "athena_artifact_path": str(Path("distributions") / native_wheel.name),
        "checksums": [{"algorithm": "SHA256", "checksumValue": sha(native_wheel)}],
    }
)
sbom = {
    "spdxVersion": "SPDX-2.3",
    "dataLicense": "CC0-1.0",
    "SPDXID": "SPDXRef-DOCUMENT",
    "name": "athena-native-dependencies",
    "documentNamespace": f"https://athena.invalid/release/{source_sha}/sbom",
    "creationInfo": {
        "created": datetime.now(timezone.utc).isoformat(),
        "creators": ["Tool: Athena release builder"],
    },
    "athenaBinding": {
        "source_sha": source_sha,
        "cargo_lock_sha256": cargo_lock_sha256,
        "uv_lock_sha256": python_lock_sha256,
        "python_package_count": len(sbom_packages) - python_package_offset,
        "native_distribution_count": 1,
    },
    "packages": sbom_packages,
}
sbom_path = out / "release-sbom.spdx.json"
sbom_path.write_text(json.dumps(sbom, indent=2, sort_keys=True) + "\n")
record = {
    "format": 1,
    "created_at_utc": datetime.now(timezone.utc).isoformat(),
    "source_sha": source_sha,
    "release_run_id": release_run_id,
    "source_status": (
        "frozen-clean"
        if os.environ.get("ATHENA_FROZEN_SOURCE") == "1"
        else run("git", "status", "--porcelain", "--untracked-files=all")
    ),
    "python_version": python_version,
    "native_version": native_version,
    "native_package_version": native_package_version,
    "cargo_lock_sha256": cargo_lock_sha256,
    "uv_lock_sha256": python_lock_sha256,
    "alacritty_git_revision": (
        alacritty_match.group(1) if alacritty_match is not None else "unavailable"
    ),
    "rustc_verbose": rustc_details,
    "cargo_version": run("cargo", "--version"),
    "target": host,
    "native_binary": {
        "path": str(binary),
        "sha256": sha(binary),
        "file": run("file", str(binary)),
        "needed": needed,
        "dynamic_section": native_dynamic,
    },
    "native_abi_policy": native_abi,
    "sbom": {
        "path": sbom_path.name,
        "sha256": sha(sbom_path),
        "component_count": len(sbom_packages),
        "python_package_count": len(sbom_packages) - python_package_offset,
        "bound_to": {
            "source_sha": source_sha,
            "cargo_lock_sha256": cargo_lock_sha256,
            "uv_lock_sha256": python_lock_sha256,
        },
    },
    "bridge_schema_version": int(bridge_version),
    "artifacts": artifacts,
}
binary_tmp.unlink(missing_ok=True)
(out / "release-manifest.json").write_text(
    json.dumps(record, indent=2, sort_keys=True) + "\n"
)
PY
printf '%s\n' "release-artifacts: built and hashed exact artifacts in $output_dir"
