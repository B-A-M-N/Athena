#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
system_python="${ATHENA_RELEASE_SYSTEM_PYTHON:-python3}"

unavailable() {
  if [[ "${ATHENA_RELEASE_GATE:-0}" == "1" ]]; then
    printf 'native-visual-smoke: FAIL — %s\n' "$1" >&2
    exit 1
  fi
  printf 'native-visual-smoke: SKIP — %s\n' "$1" >&2
  exit 0
}

command -v xvfb-run >/dev/null || {
  unavailable 'xvfb-run is unavailable'
}
command -v import >/dev/null || {
  unavailable 'ImageMagick import is unavailable'
}
command -v identify >/dev/null || {
  unavailable 'ImageMagick identify is unavailable'
}
command -v convert >/dev/null || {
  unavailable 'ImageMagick convert is unavailable'
}
command -v xdotool >/dev/null || {
  unavailable 'xdotool is unavailable'
}
command -v xdpyinfo >/dev/null || {
  unavailable 'xdpyinfo is unavailable'
}
golden_dir="${NATIVE_VISUAL_GOLDEN_DIR:-$repo_root/native/assets/oi/visual-goldens}"
update_goldens="${NATIVE_VISUAL_UPDATE_GOLDENS:-0}"
manifest_path="$golden_dir/manifest.json"
[[ -f "$manifest_path" ]] || {
  printf 'native-visual-smoke: FAIL — missing visual golden manifest %s\n' "$manifest_path" >&2
  exit 1
}
MANIFEST_PATH="$manifest_path" GOLDEN_DIR="$golden_dir" REPO_ROOT="$repo_root" UPDATE_GOLDENS="$update_goldens" "$system_python" -c '
import json
import hashlib
import os
from pathlib import Path

repo_root = Path(os.environ["REPO_ROOT"])
renderer_files = [
    "native/src/lib.rs", "native/src/x11.rs", "native/src/buddy/mod.rs",
    "native/src/buddy/poses.rs", "native/src/render/buddy.rs",
    "native/src/render/chassis.rs", "native/src/render/frame.rs",
    "native/src/render/oi.rs", "native/src/render/primitives.rs",
    "native/src/render/prompt.rs", "native/src/render/terminal.rs",
    "native/src/render/text.rs", "native/src/render/theme.rs",
]

def renderer_revision():
    digest = hashlib.sha256()
    for relative in renderer_files:
        digest.update(relative.encode())
        digest.update(b"\0")
        digest.update((repo_root / relative).read_bytes())
    return digest.hexdigest()

manifest = json.loads(Path(os.environ["MANIFEST_PATH"]).read_text(encoding="utf-8"))
update = os.environ.get("UPDATE_GOLDENS") == "1"
if not update and manifest.get("review_status") != "approved":
    raise SystemExit("visual golden manifest is not marked approved after human review")
if manifest.get("capture_clock") != "fixed":
    raise SystemExit("visual golden manifest must require the fixed presentation clock")
if not manifest.get("required_pngs"):
    raise SystemExit("visual golden manifest has no required PNGs")
if not update:
    if manifest.get("renderer_revision") != renderer_revision():
        raise SystemExit("visual golden approval is stale: renderer sources changed")
    hashes = manifest.get("golden_hashes", {})
    golden_dir = Path(os.environ["GOLDEN_DIR"])
    for name in manifest["required_pngs"]:
        path = golden_dir / name
        if not path.is_file():
            raise SystemExit(f"visual golden approval references missing {name}")
        actual = hashlib.sha256(path.read_bytes()).hexdigest()
        if hashes.get(name) != actual:
            raise SystemExit(f"visual golden approval is stale: {name} changed")
'
if [[ "$update_goldens" != "1" ]]; then
  command -v compare >/dev/null || {
    printf '%s\n' 'native-visual-smoke: FAIL — ImageMagick compare is required for golden checks' >&2
    exit 1
  }
fi
cargo build --release --manifest-path native/Cargo.toml --locked --offline >/dev/null
native_bin="$repo_root/native/target/release/athena-terminal"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

# Validate the geometry contract without requiring a display server. The
# native process emits the same rectangle model used by its renderer, so this
# catches aperture drift and prompt/rail overlap independently of OCR.
layout_json="$("$native_bin" --dump-layout)"
LAYOUT_JSON="$layout_json" "$system_python" -c '
import json
import os

layout = json.loads(os.environ["LAYOUT_JSON"])
assert layout["metrics_source"] in {"live_xft", "fallback_static"}
assert "metrics" in layout
assert layout["scale"] > 0
assert layout["canvas"]["width"] > 0
assert layout["operator_outer"]["width"] == layout["oi_outer"]["width"]
assert layout["operator_inner"]["width"] == layout["oi_inner"]["width"]
assert layout["operator_inner"]["height"] == layout["oi_inner"]["height"]
rail = layout["rail"]
prompt = layout["prompt_layout"]
status = prompt["status_row"]
hint = prompt["hint_row"]
assert status["top"] >= layout["prompt"]["y"]
assert status["top"] + status["height"] <= prompt["input_row"]["top"] + 0.01
assert prompt["input_row"]["top"] + prompt["input_row"]["height"] <= hint["top"] + 0.01
assert hint["top"] + hint["height"] <= layout["prompt"]["y"] + layout["prompt"]["height"] + 0.01
for name in ("speaker", "operator_panel", "system_status", "primary_encoder", "brightness", "focus", "power", "identity_plate"):
    rect = rail[name]
    assert rect["x"] >= rail["rail"]["x"] - 0.01
    assert rect["x"] + rect["width"] <= rail["rail"]["x"] + rail["rail"]["width"] + 0.01
'

if ! xvfb-run -a -s '-screen 0 1920x1080x24 -ac' xdpyinfo >/dev/null 2>&1; then
  unavailable 'Xvfb unavailable after layout invariants passed'
fi

# Exercise the exact five review surfaces against live Xft metrics. This is a
# separate probe from the screenshot fixtures so every supported aspect ratio
# is checked even when a fixture is added or removed later.
for size in 1672x941 1920x1080 1280x800 1280x720 1170x659; do
  IFS=x read -r matrix_width matrix_height <<< "$size"
  matrix_layout="$tmp_dir/matrix-${size}.layout.json"
  xvfb-run -a -s '-screen 0 1920x1080x24 -ac' \
    "$native_bin" --dump-layout \
    --dump-layout-size "$size" > "$matrix_layout"
  "$repo_root/scripts/check-native-layout.py" "$matrix_layout" "$matrix_width" "$matrix_height"
done

# The physical cabinet has a mandatory reviewed baseline. Dynamic terminal and
# OI fixtures remain separate so a content change cannot hide a shell drift.
"$repo_root/scripts/native-cabinet-golden"

projection='{"schema_version":3,"title":"ATHENA // VISUAL SMOKE","status":"SEARCHING","semantic_state":"search","oi":["SYMBOL GRAPH // FIXED CLOCK"],"current_action":{"kind":"search","label":"workspace","target":"workspace","query":"workspace"},"active_operation":{"id":"op-01","label":"inspect workspace","target":"workspace","state":"running","action_kind":"search","mutation_state":"read-only"},"model_request":{"provider":"local","model":"athena-model","status":"active"},"workspace_tree":[{"id":"workspace","kind":"workspace","label":"/workspace","status":"ready","children":[{"id":"src","kind":"directory","label":"src/athena","status":"ready"},{"id":"native","kind":"file","label":"native.rs","status":"reading"},{"id":"tests","kind":"directory","label":"tests","status":"ready"}]}],"runtime_tree":[{"id":"inspect","kind":"task","label":"inspect workspace","status":"running","children":[{"id":"read","kind":"execution","label":"read native.rs","status":"active"}]}],"entities":[{"id":"root","kind":"operation","label":"workspace","status":"active"},{"id":"child","kind":"task","label":"native.rs","status":"active","parent_id":"root"}],"attention_items":[],"buddy":{"state":"SEARCH","anchor":"right","status":"active","character":"owl"},"trace":["> SEARCH · workspace"],"view":{"mode":"search"}}'

  PROJECTION="$projection" NATIVE_BIN="$native_bin" TMP_DIR="$tmp_dir" \
  GOLDEN_DIR="$golden_dir" UPDATE_GOLDENS="$update_goldens" CHECK_LAYOUT="$repo_root/scripts/check-native-layout.py" \
  CHECK_OI_VISUAL="$repo_root/scripts/check-native-oi-visual.py" \
  ATHENA_RELEASE_SYSTEM_PYTHON="$system_python" \
  xvfb-run -a -s '-screen 0 1920x1080x24 -ac' bash -c '
    set -euo pipefail
    system_python="${ATHENA_RELEASE_SYSTEM_PYTHON:-python3}"

    wait_for_window() {
      timeout 10s xdotool search --sync --name "ATHENA" 2>/dev/null | head -1
    }

    presentation_sequence() {
      PRESENTATION_PATH="$1" "$system_python" - <<'PY'
import json
import os
from pathlib import Path

path = Path(os.environ["PRESENTATION_PATH"])
print(json.loads(path.read_text(encoding="utf-8"))["presented_frame_sequence"] if path.is_file() else 0)
PY
    }

    wait_for_presentation() {
      PRESENTATION_PATH="$1" MIN_SEQUENCE="$2" EXPECTED_WIDTH="$3" EXPECTED_HEIGHT="$4" EXPECTED_STATE="${5:-}" "$system_python" - <<'PY'
import json
import os
import time
from pathlib import Path

path = Path(os.environ["PRESENTATION_PATH"])
minimum = int(os.environ["MIN_SEQUENCE"])
width = int(os.environ["EXPECTED_WIDTH"])
height = int(os.environ["EXPECTED_HEIGHT"])
state = os.environ.get("EXPECTED_STATE")
deadline = time.monotonic() + 10.0
while time.monotonic() < deadline:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (FileNotFoundError, OSError, json.JSONDecodeError):
        value = None
    if (
        isinstance(value, dict)
        and int(value.get("presented_frame_sequence", 0)) >= minimum
        and int(value.get("width", 0)) == width
        and int(value.get("height", 0)) == height
        and (not state or value.get("semantic_state") == state)
    ):
        raise SystemExit(0)
    time.sleep(0.01)
raise SystemExit(
    f"presentation sync timeout: sequence >= {minimum}, {width}x{height}, state={state!r}"
)
PY
    }

    resize_sequence() {
      local layout_path="$TMP_DIR/live-resize.layout.json"
      local sync_path="$TMP_DIR/live-resize.presentation.json"
      ATHENA_PRESENTATION_CLOCK=fixed ATHENA_NATIVE_LAYOUT_DUMP="$layout_path" ATHENA_NATIVE_PRESENTATION_SYNC="$sync_path" "$NATIVE_BIN" --no-animations --command "tail -f /dev/null" >/dev/null 2>&1 &
      local native_pid=$!
      local window
      window="$(wait_for_window)"
      xdotool windowfocus --sync "$window"
      xdotool windowsize --sync "$window" 1280 800
      wait_for_presentation "$sync_path" 1 1280 800
      local last_sequence
      last_sequence="$(presentation_sequence "$sync_path")"
      "$CHECK_LAYOUT" "$layout_path" 1280 800
      for size in 1672x941 1170x659 1920x1080 1280x720; do
        IFS=x read -r resize_width resize_height <<< "$size"
        xdotool windowsize --sync "$window" "$resize_width" "$resize_height"
        wait_for_presentation "$sync_path" "$((last_sequence + 1))" "$resize_width" "$resize_height"
        last_sequence="$(presentation_sequence "$sync_path")"
        "$CHECK_LAYOUT" "$layout_path" "$resize_width" "$resize_height"
      done
      kill "$native_pid" 2>/dev/null || true
      wait "$native_pid" 2>/dev/null || true
    }

    capture_fixture() {
      local label="$1"
      local scene_mode="$2"
      local mascot="$3"
      local input="$4"
      local size="${5:-1280x800}"
      local animation_mode="${6:-static}"
      IFS=x read -r expected_width expected_height <<< "$size"
      local animation_args=(--no-animations)
      if [[ "$animation_mode" == "animated" ]]; then
        animation_args=()
      fi
      local fixture_projection="${PROJECTION//\"search\"/\"$scene_mode\"}"
      local upper_mode="${scene_mode^^}"
      fixture_projection="${fixture_projection//\"SEARCH\"/\"$upper_mode\"}"
      fixture_projection="${fixture_projection//\"owl\"/\"$mascot\"}"
      fixture_projection="$(FIXTURE_PROJECTION="$fixture_projection" SCENE_MODE="$scene_mode" "$system_python" -c "import json, os; f=json.loads(os.environ[\"FIXTURE_PROJECTION\"]); m=os.environ[\"SCENE_MODE\"]; f[\"attention_items\"] = ([{\"id\":\"approval:visual-smoke\",\"approval_id\":\"apr-visual-smoke\",\"kind\":\"approval\",\"severity\":\"warning\",\"title\":\"APPROVAL REQUIRED\",\"summary\":\"write workspace\",\"requires_action\":True,\"scopes\":[\"call\",\"task\"],\"related_object_id\":\"op-01\"}] if m == \"approval\" else [{\"id\":\"event:visual-smoke\",\"kind\":\"notification\",\"severity\":\"failure\",\"title\":\"EVENT\",\"summary\":\"visual verification failed\",\"requires_action\":False,\"related_object_id\":\"op-01\"}] if m == \"failure\" else f[\"attention_items\"]); print(json.dumps(f))")"
      local image_path="$TMP_DIR/${label}-${mascot}.png"
      local layout_path="$TMP_DIR/${label}-${mascot}.layout.json"
      local oi_path="$TMP_DIR/${label}-${mascot}.oi.png"
      local sync_path="$TMP_DIR/${label}-${mascot}.presentation.json"

      printf "native-visual-smoke: capture %s-%s (%s, %s)\\n" "$label" "$mascot" "$size" "$scene_mode" >&2
      printf "%s\\n" "$fixture_projection" | ATHENA_PRESENTATION_CLOCK=fixed ATHENA_NATIVE_LAYOUT_DUMP="$layout_path" ATHENA_NATIVE_OI_DUMP="$oi_path" ATHENA_NATIVE_PRESENTATION_SYNC="$sync_path" "$NATIVE_BIN" --bridge-stdin "${animation_args[@]}" \
        --mascot "$mascot" --command "printf native-ok; tail -f /dev/null" >/dev/null 2>&1 &
      local native_pid=$!
      local window
      window="$(wait_for_window)"
      xdotool windowfocus --sync "$window"
      xdotool windowsize --sync "$window" "$expected_width" "$expected_height"
      wait_for_presentation "$sync_path" 1 "$expected_width" "$expected_height" "$scene_mode"
      local last_sequence
      last_sequence="$(presentation_sequence "$sync_path")"
      if [[ -n "$input" ]]; then
        xdotool type --window "$window" --clearmodifiers "$input"
        xdotool key --window "$window" Left Left
        wait_for_presentation "$sync_path" "$((last_sequence + 1))" "$expected_width" "$expected_height" "$scene_mode"
      fi
      import -window "$window" "$image_path"
      kill "$native_pid" 2>/dev/null || true
      wait "$native_pid" 2>/dev/null || true

      [[ -s "$layout_path" ]] || {
        printf "native-visual-smoke: FAIL — missing live layout dump %s\\n" "$layout_path" >&2
        return 1
      }
      LAYOUT_PATH="$layout_path" "$system_python" -c "import json, os; l=json.loads(open(os.environ[\"LAYOUT_PATH\"], encoding=\"utf-8\").read()); assert l[\"metrics_source\"] == \"live_xft\"; assert all(l[\"metrics\"][r][\"height\"] > 0 for r in (\"body\", \"input\", \"heading\", \"instrument\")); p=l[\"prompt_layout\"]; assert p[\"status_row\"][\"top\"] + p[\"status_row\"][\"height\"] <= p[\"input_row\"][\"top\"] + 0.01; assert p[\"input_row\"][\"top\"] + p[\"input_row\"][\"height\"] <= p[\"hint_row\"][\"top\"] + 0.01; assert p[\"hint_row\"][\"top\"] + p[\"hint_row\"][\"height\"] <= l[\"prompt\"][\"y\"] + l[\"prompt\"][\"height\"] + 0.01"
      [[ -s "$oi_path" ]] || {
        printf "native-visual-smoke: FAIL — missing 384x256 OI dump %s\\n" "$oi_path" >&2
        return 1
      }
      [[ "$(identify -format "%wx%h" "$oi_path")" == "384x256" ]] || {
        printf "native-visual-smoke: FAIL — OI dump has unexpected dimensions\\n" >&2
        return 1
      }
      "$system_python" "$CHECK_OI_VISUAL" "$oi_path"

      if [[ -n "$GOLDEN_DIR" ]]; then
        local golden_path="$GOLDEN_DIR/${label}-${mascot}.png"
        if [[ "$UPDATE_GOLDENS" == "1" ]]; then
          mkdir -p "$GOLDEN_DIR"
          cp "$image_path" "$golden_path"
        elif [[ -f "$golden_path" ]]; then
          local rmse normalized
          rmse="$(compare -metric RMSE "$golden_path" "$image_path" null: 2>&1 || true)"
          normalized="$(printf "%s\\n" "$rmse" | cut -d "(" -f 2 | cut -d ")" -f 1 | tr -d "[:space:]")"
          awk -v rmse="$normalized" "BEGIN { exit !(rmse != \"\" && rmse <= 0.08) }" || {
            printf "native-visual-smoke: FAIL — %s exceeds golden RMSE tolerance (%s)\\n" "$label-$mascot" "$normalized" >&2
            return 1
          }
        else
          printf "native-visual-smoke: FAIL — missing golden %s\\n" "$golden_path" >&2
          return 1
        fi
      fi

      local dimensions colors stddev
      dimensions="$(identify -format "%wx%h" "$image_path")"
      [[ "$dimensions" == "${expected_width}x${expected_height}" ]] || {
        printf "native-visual-smoke: FAIL — %s has dimensions %s\\n" "$label-$mascot" "$dimensions" >&2
        return 1
      }
      [[ -s "$image_path" ]] || {
        printf "native-visual-smoke: FAIL — %s is empty\\n" "$label-$mascot" >&2
        return 1
      }
      colors="$(identify -format "%k" "$image_path")"
      [[ "$colors" -ge 100 ]] || {
        printf "native-visual-smoke: FAIL — %s has only %s colors\\n" "$label-$mascot" "$colors" >&2
        return 1
      }
      stddev="$(convert "$image_path" -colorspace Gray -format "%[standard_deviation]" info:)"
      awk -v stddev="$stddev" "BEGIN { exit !(stddev > 0.01) }" || {
        printf "native-visual-smoke: FAIL — %s contrast invariant failed (%s)\\n" "$label-$mascot" "$stddev" >&2
        return 1
      }
    }

    resize_sequence

    # Regression for the compositor ordering bug: after the initial full
    # presentation, animated OI frames must not copy over the Xft-owned
    # operator transcript. Capture the same operator aperture across several
    # OI-only frames and require it to remain byte-identical.
    operator_text_persistence() (
      set -euo pipefail
      local image_prefix="${TMP_DIR}/operator-persistence"
      local crop_prefix="${TMP_DIR}/operator-persistence-crop"
      local layout_path="${TMP_DIR}/operator-persistence.layout.json"
      local sync_path="${TMP_DIR}/operator-persistence.presentation.json"
      local native_pid
      cleanup() {
        kill "${native_pid}" 2>/dev/null || true
        wait "${native_pid}" 2>/dev/null || true
      }
      trap cleanup EXIT

      printf "%s\n" "${PROJECTION}" | ATHENA_PRESENTATION_CLOCK=fixed ATHENA_NATIVE_LAYOUT_DUMP="${layout_path}" ATHENA_NATIVE_PRESENTATION_SYNC="${sync_path}" "${NATIVE_BIN}" --bridge-stdin \
        --mascot owl --command "printf native-ok; tail -f /dev/null" >/dev/null 2>&1 &
      native_pid=$!
      local window
      window="$(wait_for_window)"
      xdotool windowfocus --sync "${window}"
      xdotool windowsize --sync "${window}" 1280 800
      wait_for_presentation "${sync_path}" 1 1280 800 search

      # The persistence fixture deliberately uses the fixed 1280x800 review
      # surface. These are the rounded operator viewport coordinates emitted
      # by the same responsive layout contract.
      local operator_crop="480x408+98+185"
      import -window "${window}" "${image_prefix}-0.png"
      convert "${image_prefix}-0.png" -crop "${operator_crop}" +repage "${crop_prefix}-0.png"
      local last_sequence
      last_sequence="$(presentation_sequence "${sync_path}")"
      for sample in 1 2 3; do
        wait_for_presentation "${sync_path}" "$((last_sequence + 1))" 1280 800 search
        last_sequence="$(presentation_sequence "${sync_path}")"
        import -window "${window}" "${image_prefix}-${sample}.png"
        convert "${image_prefix}-${sample}.png" -crop "${operator_crop}" +repage "${crop_prefix}-${sample}.png"
        local rmse normalized
        rmse="$(compare -metric RMSE "${crop_prefix}-0.png" "${crop_prefix}-${sample}.png" null: 2>&1 || true)"
        normalized="$(printf "%s\n" "${rmse}" | cut -d "(" -f 2 | cut -d ")" -f 1 | tr -d "[:space:]")"
        if [[ "$normalized" != "0" ]]; then
          printf "native-visual-smoke: FAIL — operator transcript changed during OI animation (%s)\n" "${normalized}" >&2
          return 1
        fi
      done
      printf "%s\n" "native-visual-smoke: compositor persistence regression passed"
    )

    operator_text_persistence

    # 9 scene/input fixtures × 3 built-in sprites. Layout symmetry and
    # non-overlap are additionally asserted by NativePixelLayout unit tests.
    capture_fixture idle idle owl ""
    capture_fixture idle idle cat ""
    capture_fixture idle idle bot ""
    capture_fixture typing-short idle owl "hi"
    capture_fixture typing-short idle cat "hi"
    capture_fixture typing-short idle bot "hi"
    long_input="inspect the entire workspace tree and report every changed file with paths, states, and the next safe action"
    [[ "${#long_input}" -ge 80 ]]
    capture_fixture typing-long idle owl "$long_input"
    capture_fixture typing-long idle cat "$long_input"
    capture_fixture typing-long idle bot "$long_input"
    for scene_mode in search read code test approval failure; do
      for mascot in owl cat bot; do
        capture_fixture "$scene_mode" "$scene_mode" "$mascot" ""
      done
    done

    # The physical reference and the larger active-world surfaces are separate
    # reviewed evidence. They must not be hidden behind the 1280x800 smoke.
    for scene_mode in idle search code approval; do
      for mascot in owl cat bot; do
        capture_fixture "1672-${scene_mode}" "$scene_mode" "$mascot" "" 1672x941
      done
    done

    # Fixed-clock temporal samples make animation cadence and semantic state
    # transitions reviewable without relying on wall-clock timing.
    for scene_mode in idle search code execute failure recover; do
      capture_fixture "temporal-${scene_mode}" "$scene_mode" owl "" 1280x800 animated
    done
  '

if [[ "$update_goldens" == "1" ]]; then
  MANIFEST_PATH="$manifest_path" GOLDEN_DIR="$golden_dir" REPO_ROOT="$repo_root" "$system_python" -c '
import hashlib
import json
import os
from pathlib import Path

repo_root = Path(os.environ["REPO_ROOT"])
manifest_path = Path(os.environ["MANIFEST_PATH"])
golden_dir = Path(os.environ["GOLDEN_DIR"])
renderer_files = [
    "native/src/lib.rs", "native/src/x11.rs", "native/src/buddy/mod.rs",
    "native/src/buddy/poses.rs", "native/src/render/buddy.rs",
    "native/src/render/chassis.rs", "native/src/render/frame.rs",
    "native/src/render/oi.rs", "native/src/render/primitives.rs",
    "native/src/render/prompt.rs", "native/src/render/terminal.rs",
    "native/src/render/text.rs", "native/src/render/theme.rs",
]
revision = hashlib.sha256()
for relative in renderer_files:
    revision.update(relative.encode())
    revision.update(b"\0")
    revision.update((repo_root / relative).read_bytes())
manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
manifest["review_status"] = "pending"
manifest["renderer_revision"] = revision.hexdigest()
manifest["golden_hashes"] = {
    name: hashlib.sha256((golden_dir / name).read_bytes()).hexdigest()
    for name in manifest["required_pngs"]
}
manifest_path.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
'
fi

printf '%s\n' 'native-visual-smoke: PASS — mandatory responsive, semantic, Buddy, and fixed-clock visual evidence'
