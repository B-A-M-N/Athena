#!/usr/bin/env python3
"""Scenario runner: executes the release-gate scenario families and emits a
machine-readable evidence manifest (audit items P1.29/P1.30).

What it does
------------
1. Loads the declarative scenario registry (``tests/scenarios/registry.py``),
   which binds named scenario IDs (e.g. ``SYNTH-001``) to real pytest node
   IDs or a documented probe command.
2. Runs each selected scenario's evidence:
     * pytest scenarios -> ``python -m pytest -q <nodeids...>`` (one pytest
       invocation per scenario; exit 0 = passed, anything else = failed);
     * probe scenarios  -> the probe argv from the repo root. The only probe
       today is ``scripts/render-demo`` whose exit-code contract is
       documented in its header: 0 success, 2 tool/argument error, 3 timeout,
       4 vhs failure, 5 artifact validation failure. Exit 2 with ``vhs``
       absent from PATH means "skipped" (environment lacks the renderer), not
       a failure.
3. Writes a JSON manifest to ``--output`` (default ``scenarios-manifest.json``
   for an unfiltered run):

       {
         "generated_at": "...",
         "repo_root": "...",
         "scenarios": [
           {"scenario": "SYNTH-001", "family": "SYNTH",
            "title": "...", "required": true,
            "status": "passed|failed|missing|skipped",
            "evidence": [{"kind": "pytest"|"probe", "ref": "...",
                          "exit_code": 0, "duration_s": 1.2, ...}],
            "duration_s": 3.4, "notes": "..."}
         ],
         "families": {"SYNTH": {"passed": 4, "failed": 0, "missing": 1, ...}},
         "summary": {"total": 50, "passed": 47, "failed": 0,
                     "missing": 2, "skipped": 1, "required_missing": 0}
       }

4. Exit code: 0 iff every REQUIRED scenario is ``passed``.  A required
   scenario that is ``missing`` (declared gap in the registry) or ``failed``
   (its evidence ran and did not pass) makes the run fail.  Optional
   scenarios may be ``missing``/``skipped`` without failing the run.

Honesty rules
-------------
* A scenario is only ``passed`` when its bound evidence ran *in this
  invocation* and exited zero.  Nothing is inferred from previous runs,
  file existence, or scenario titles.
* Registry entries with ``status="MISSING"`` are declared gaps: they are
  reported as ``missing`` and never executed.

Usage
-----
    scripts/scenarios                              # all families
    scripts/scenarios --family SYNTH --family COMPAT --output /tmp/scm.json
    scripts/scenarios --exclude-family VHS --output /tmp/scm.json
    scripts/scenarios --output /tmp/scm.json
    scripts/scenarios --list                       # registry dump, no runs
    scripts/scenarios --only SYNTH-001 --output /tmp/scm.json

Environment
-----------
``ATHENA_PYTHON`` overrides the interpreter used for pytest (default: the
``python3`` on PATH; the Makefile passes the venv interpreter via ``uv run``).
"""

from __future__ import annotations

import argparse
import datetime as _dt
import hashlib
import json
import os
import subprocess
import sys
import time
from collections import Counter
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT))

from tests.scenarios.registry import (  # noqa: E402  (path setup above)
    FAMILY_DESCRIPTIONS,
    FAMILY_ORDER,
    SCENARIOS,
    Scenario,
)

# render-demo exit codes (contract fixed in that script's header).
RENDER_DEMO_EXIT_NAMES = {
    0: "success",
    2: "tool-or-argument-error",
    3: "timeout",
    4: "vhs-failure",
    5: "artifact-validation-failure",
}


def _artifact_identity() -> dict[str, object]:
    """Return hashes for the installed-artifact bundle when one is present.

    Release scenarios run after the artifact lane in the frozen checkout, so
    attaching this record to every scenario prevents a green scenario result
    from being mistaken for proof against some other wheel or source archive.
    Developer runs retain an explicit ``not_available`` status instead of
    inventing an artifact hash.
    """
    configured = os.environ.get("ATHENA_RELEASE_ARTIFACT_DIR")
    root = Path(configured).resolve() if configured else REPO_ROOT / "release-artifacts"
    manifest_path = root / "release-manifest.json"
    if not manifest_path.is_file():
        return {
            "status": "not_available",
            "manifest": None,
            "artifacts": [],
            "reason": "scenario run was not supplied a release artifact bundle",
        }
    try:
        raw = manifest_path.read_bytes()
        manifest = json.loads(raw)
        artifacts = [
            {
                "path": str(item.get("path") or ""),
                "sha256": str(item.get("sha256") or ""),
            }
            for item in manifest.get("artifacts") or ()
            if isinstance(item, dict)
        ]
        return {
            "status": "available",
            "manifest": str(manifest_path),
            "manifest_sha256": hashlib.sha256(raw).hexdigest(),
            "source_sha": manifest.get("source_sha"),
            "artifacts": artifacts,
        }
    except (OSError, TypeError, ValueError) as exc:
        return {
            "status": "invalid",
            "manifest": str(manifest_path),
            "artifacts": [],
            "reason": f"release manifest could not be read: {type(exc).__name__}: {exc}",
        }

# Keep the scenario-process allowance aligned with scripts/render-demo's
# default timeout (600s) plus a small parent-process margin.  This used to
# default to 120s here, so a valid ~90s recording could be killed during VHS
# encoding before render-demo's own timeout was reached.
DEFAULT_DEMO_TIMEOUT = 600.0


def _python() -> str:
    return os.environ.get("ATHENA_PYTHON", sys.executable or "python3")


def _child_env() -> dict[str, str]:
    """Environment for pytest children: THIS worktree's src wins.

    Without this, an editable install pointing at another checkout (e.g. the
    main repo while running from an agent worktree) would silently test the
    wrong code and the manifest would be dishonest evidence.
    """
    env = dict(os.environ)
    src = str(REPO_ROOT / "src")
    existing = env.get("PYTHONPATH", "")
    env["PYTHONPATH"] = src + (os.pathsep + existing if existing else "")
    return env


def _release_identity() -> dict[str, str | bool]:
    """Bind evidence to the exact source and interpreter that ran it."""

    def git(*arguments: str) -> str:
        try:
            return subprocess.run(
                ["git", *arguments],
                cwd=REPO_ROOT,
                check=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
            ).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            return "unknown"

    frozen_source = os.environ.get("ATHENA_FROZEN_SOURCE") == "1"
    status = "" if frozen_source else git("status", "--porcelain", "--untracked-files=all")
    runner = _python()
    try:
        version = (
            subprocess.run(
                [runner, "--version"],
                cwd=REPO_ROOT,
                check=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
            )
            .stdout.strip()
            .removeprefix("Python ")
        )
    except (OSError, subprocess.SubprocessError):
        version = "unknown"
    return {
        "head_sha": (
            os.environ.get("ATHENA_RELEASE_SHA", "unknown")
            if frozen_source
            else git("rev-parse", "HEAD")
        ),
        "release_run_id": os.environ.get("ATHENA_RELEASE_RUN_ID", "local"),
        "dirty": bool(status),
        "status_digest": __import__("hashlib").sha256(status.encode("utf-8")).hexdigest(),
        "python": runner,
        "python_version": version,
        "platform": sys.platform,
    }


def _run(argv: list[str], *, timeout: float) -> dict:
    """Run one command; return an evidence record with the REAL exit code."""
    started = time.monotonic()
    try:
        proc = subprocess.run(
            argv,
            cwd=REPO_ROOT,
            timeout=timeout,
            env=_child_env(),
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
        )
        rc, out = proc.returncode, proc.stdout
    except subprocess.TimeoutExpired as exc:
        rc = 124
        out = (
            (exc.stdout or b"").decode("utf-8", "replace")
            if isinstance(exc.stdout, bytes)
            else (exc.stdout or "")
        )
    except OSError as exc:
        rc = 127
        out = f"{type(exc).__name__}: {exc}"
    return {
        "kind": "probe",
        "command": argv,
        "exit_code": rc,
        "duration_s": round(time.monotonic() - started, 3),
        "tail": out[-2000:],
    }


def _run_pytest(nodeids: list[str]) -> dict:
    """Run one pytest invocation over the scenario's node IDs."""
    # Keep the scenario subprocess on the repository's normal pytest plugin
    # path. Disabling cacheprovider here makes real-runtime groups hang during
    # teardown even though the same node IDs pass through the normal suite.
    argv = [_python(), "-m", "pytest", "-q", *nodeids]
    started = time.monotonic()
    try:
        proc = subprocess.run(
            argv,
            cwd=REPO_ROOT,
            timeout=1200,
            env=_child_env(),
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
        )
        rc, out = proc.returncode, proc.stdout
    except subprocess.TimeoutExpired:
        rc = 124
        out = "pytest timed out after 1200s"
    except OSError as exc:
        rc = 127
        out = f"{type(exc).__name__}: {exc}"
    return {
        "kind": "pytest",
        "command": argv,
        "nodeids": nodeids,
        "exit_code": rc,
        "duration_s": round(time.monotonic() - started, 3),
        "tail": out[-2000:],
    }


def _vhs_probe_skipped(record: dict) -> bool:
    """Probe exited 2 because rendering is unavailable -> 'skipped'.

    render-demo exits 2 for tool/argument errors; when the failure is simply
    ``vhs not on PATH`` or a sized PTY cannot be created in this environment,
    the evidence exists but could not be produced, so the scenario is
    *skipped*, not failed. Any other exit (3/4/5, or 2 with a different
    message) is a real failure.
    """
    if record["exit_code"] != 2:
        return False
    tail = record.get("tail", "")
    return "vhs not on PATH" in tail or "could not create the VHS PTY session" in tail


def execute_scenario(
    sc: Scenario,
    *,
    identity: dict[str, str | bool],
    receipt_dir: Path | None = None,
    resume: bool = False,
) -> dict:
    """Run one scenario; return its manifest entry with an honest status."""
    receipt_path = receipt_dir / f"{sc.id}.json" if receipt_dir else None
    if resume and receipt_path is not None:
        try:
            prior = json.loads(receipt_path.read_text(encoding="utf-8"))
        except (FileNotFoundError, OSError, TypeError, ValueError):
            prior = None
        if (
            isinstance(prior, dict)
            and prior.get("source_identity") == identity
            and prior.get("status") in {"passed", "skipped", "missing"}
        ):
            prior["resumed"] = True
            return prior

    entry = {
        "scenario": sc.id,
        "family": sc.family,
        "title": sc.title,
        "required": sc.required,
        "commit_sha": identity["head_sha"],
        "release_run_id": identity["release_run_id"],
        "status": None,
        "evidence": [],
        "duration_s": 0.0,
        "source_identity": identity,
        "artifact_identity": _artifact_identity(),
    }
    if sc.notes:
        entry["notes"] = sc.notes

    if sc.status == "MISSING":
        entry["status"] = "missing"
        if receipt_path is not None:
            receipt_path.parent.mkdir(parents=True, exist_ok=True)
            _write_json_atomic(receipt_path, entry)
        return entry

    started = time.monotonic()
    if sc.nodeids:
        record = _run_pytest(list(sc.nodeids))
        record["commit_sha"] = str(identity["head_sha"])
        record["release_run_id"] = str(identity["release_run_id"])
        entry["evidence"].append(record)
        entry["status"] = "passed" if record["exit_code"] == 0 else "failed"
    elif sc.probe:
        record = _run(
            list(sc.probe),
            timeout=float(os.environ.get("ATHENA_DEMO_TIMEOUT", DEFAULT_DEMO_TIMEOUT)) + 30.0,
        )
        record["probe_exit"] = RENDER_DEMO_EXIT_NAMES.get(
            record["exit_code"], f"exit-{record['exit_code']}"
        )
        record["commit_sha"] = str(identity["head_sha"])
        record["release_run_id"] = str(identity["release_run_id"])
        entry["evidence"].append(record)
        if record["exit_code"] == 0:
            entry["status"] = "passed"
        elif _vhs_probe_skipped(record):
            entry["status"] = "skipped"
        else:
            entry["status"] = "failed"
    else:  # registry validation makes this unreachable
        entry["status"] = "missing"
    entry["duration_s"] = round(time.monotonic() - started, 3)
    if receipt_path is not None:
        receipt_path.parent.mkdir(parents=True, exist_ok=True)
        _write_json_atomic(receipt_path, entry)
    return entry


def _write_json_atomic(path: Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp")
    tmp.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="scripts/scenarios",
        description="Run release-gate scenario families and emit an "
        "evidence manifest (P1.29/P1.30).",
    )
    parser.add_argument(
        "--output",
        "-o",
        default=None,
        help=(
            "path for the JSON evidence manifest; unfiltered runs default to "
            "scenarios-manifest.json (filtered runs require an explicit path)"
        ),
    )
    parser.add_argument(
        "--family",
        action="append",
        default=None,
        help="restrict to a family (repeatable): " + ", ".join(FAMILY_ORDER),
    )
    parser.add_argument(
        "--exclude-family",
        action="append",
        default=None,
        help="omit a family (repeatable): " + ", ".join(FAMILY_ORDER),
    )
    parser.add_argument(
        "--only",
        action="append",
        default=None,
        help="restrict to individual scenario ids (repeatable), e.g. SYNTH-001",
    )
    parser.add_argument(
        "--manifest-dir",
        default=None,
        help="directory for one atomic receipt per scenario (enables resume)",
    )
    parser.add_argument(
        "--resume",
        action="store_true",
        help="reuse receipts only when their source identity matches exactly",
    )
    parser.add_argument(
        "--require-clean",
        action="store_true",
        help="fail before running when the checkout has uncommitted changes",
    )
    parser.add_argument(
        "--list", action="store_true", help="print the registry without running anything"
    )
    parser.add_argument("--quiet", "-q", action="store_true", help="only print the summary line")
    args = parser.parse_args(argv)

    selected = SCENARIOS
    if args.family:
        unknown = [f for f in args.family if f not in FAMILY_ORDER]
        if unknown:
            parser.error(f"unknown family(ies): {', '.join(unknown)}")
        selected = tuple(s for s in selected if s.family in set(args.family))
    if args.exclude_family:
        unknown = [f for f in args.exclude_family if f not in FAMILY_ORDER]
        if unknown:
            parser.error(f"unknown family(ies): {', '.join(unknown)}")
        selected = tuple(s for s in selected if s.family not in set(args.exclude_family))
    if args.only:
        known = {s.id for s in SCENARIOS}
        unknown = [i for i in args.only if i not in known]
        if unknown:
            parser.error(f"unknown scenario id(s): {', '.join(unknown)}")
        selected = tuple(s for s in selected if s.id in set(args.only))

    if args.list:
        for sc in selected:
            print(
                f"{sc.id:<15} {sc.status:<8} "
                f"{'required' if sc.required else 'optional':<9} {sc.title}"
            )
            for n in sc.nodeids:
                print(f"                pytest  {n}")
            if sc.probe:
                print(f"                probe   {' '.join(sc.probe)}")
        return 0

    identity = _release_identity()
    if args.require_clean and identity["dirty"]:
        parser.error(
            "checkout is dirty; use a clean release checkout or omit "
            "--require-clean for developer runs"
        )

    if args.output is None:
        if args.family or args.exclude_family or args.only:
            parser.error(
                "filtered scenario runs require --output; refusing to overwrite "
                "the full checked-in manifest"
            )
        args.output = "scenarios-manifest.json"

    receipt_dir = Path(args.manifest_dir) if args.manifest_dir else None
    entries = []
    for sc in selected:
        if not args.quiet:
            print(f"[..] {sc.id} {sc.title}", flush=True)
        entry = execute_scenario(
            sc,
            identity=identity,
            receipt_dir=receipt_dir,
            resume=args.resume,
        )
        entries.append(entry)
        if not args.quiet:
            print(f"[{entry['status']:>7}] {sc.id} ({entry['duration_s']}s)", flush=True)

    families: dict[str, dict] = {}
    for fam in FAMILY_ORDER:
        fam_entries = [e for e in entries if e["family"] == fam]
        if not fam_entries:
            continue
        counts = Counter(e["status"] for e in fam_entries)
        families[fam] = {
            "description": FAMILY_DESCRIPTIONS[fam],
            "total": len(fam_entries),
            **{k: counts.get(k, 0) for k in ("passed", "failed", "missing", "skipped")},
        }

    summary = Counter(e["status"] for e in entries)
    required_missing = [e["scenario"] for e in entries if e["required"] and e["status"] != "passed"]
    manifest = {
        "generated_at": _dt.datetime.now(_dt.timezone.utc).isoformat(),
        "repo_root": str(REPO_ROOT),
        "commit_sha": identity["head_sha"],
        "release_run_id": identity["release_run_id"],
        "source_identity": identity,
        "resumed": bool(args.resume),
        "scenarios": entries,
        "families": families,
        "summary": {
            "total": len(entries),
            "passed": summary.get("passed", 0),
            "failed": summary.get("failed", 0),
            "missing": summary.get("missing", 0),
            "skipped": summary.get("skipped", 0),
            "required_not_passed": required_missing,
        },
    }

    out_path = Path(args.output)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    _write_json_atomic(out_path, manifest)

    s = manifest["summary"]
    print(
        f"\nscenarios: {s['total']} total, {s['passed']} passed, "
        f"{s['failed']} failed, {s['missing']} missing, {s['skipped']} skipped"
    )
    print(f"manifest: {out_path}")
    if s["required_not_passed"]:
        print("REQUIRED scenarios not passed: " + ", ".join(s["required_not_passed"]))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
