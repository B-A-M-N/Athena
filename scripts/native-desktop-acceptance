#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
desktop_receipt="${ATHENA_NATIVE_DESKTOP_RECEIPT:-native-desktop-acceptance.json}"
system_python="${ATHENA_RELEASE_SYSTEM_PYTHON:-python3}"

write_desktop_receipt() {
  local header_strategy="$1"
  local fallback_reason=""
  local active_strategy=""
  if [[ -n "${resize_dump:-}" && -f "$resize_dump" ]]; then
    read -r fallback_reason active_strategy < <(
      LAYOUT_PATH="$resize_dump" "$system_python" -c '
import json, os
try:
    layout = json.loads(open(os.environ["LAYOUT_PATH"], encoding="utf-8").read())
except (OSError, ValueError):
    layout = {}
management = layout.get("window_management") or {}
print(management.get("fallback_reason") or "", management.get("active_strategy") or "")
'
    )
  fi
  ATHENA_DESKTOP_RECEIPT="$desktop_receipt" \
    ATHENA_DESKTOP_STRATEGY="$window_strategy" \
    ATHENA_DESKTOP_HEADER_STRATEGY="$header_strategy" \
    ATHENA_DESKTOP_WM="${wm_name:-unknown}" \
    ATHENA_DESKTOP_SUPPORTING_WM="${wm_supporting_window:-unknown}" \
    ATHENA_DESKTOP_XSERVER="${xserver_identity:-unknown}" \
    ATHENA_DESKTOP_FALLBACK_REASON="$fallback_reason" \
    ATHENA_DESKTOP_ACTIVE_STRATEGY="$active_strategy" \
    ATHENA_DESKTOP_RELEASE_SHA="${ATHENA_RELEASE_SHA:-}" \
    ATHENA_DESKTOP_RELEASE_RUN_ID="${ATHENA_RELEASE_RUN_ID:-}" \
    "$system_python" -c '
import json, os
record = {
    "kind": "athena_native_desktop_receipt",
    "status": "PASS",
    "display": os.environ.get("DISPLAY"),
    "session_type": os.environ.get("XDG_SESSION_TYPE", "unknown"),
    "window_strategy": os.environ.get("ATHENA_DESKTOP_STRATEGY"),
    "header_strategy": os.environ.get("ATHENA_DESKTOP_HEADER_STRATEGY"),
    "wm": os.environ.get("ATHENA_DESKTOP_WM", "unknown"),
    "supporting_wm_check": os.environ.get("ATHENA_DESKTOP_SUPPORTING_WM", "unknown"),
    "xserver": os.environ.get("ATHENA_DESKTOP_XSERVER", "unknown"),
    "fallback_reason": os.environ.get("ATHENA_DESKTOP_FALLBACK_REASON") or None,
    "active_strategy": os.environ.get("ATHENA_DESKTOP_ACTIVE_STRATEGY") or None,
}
if os.environ.get("ATHENA_DESKTOP_RELEASE_SHA"):
    record["source_sha"] = os.environ["ATHENA_DESKTOP_RELEASE_SHA"]
if os.environ.get("ATHENA_DESKTOP_RELEASE_RUN_ID"):
    record["release_run_id"] = os.environ["ATHENA_DESKTOP_RELEASE_RUN_ID"]
with open(os.environ["ATHENA_DESKTOP_RECEIPT"], "w", encoding="utf-8") as handle:
    json.dump(record, handle, indent=2, sort_keys=True)
    handle.write("\n")
'
}

[[ -n "${DISPLAY:-}" ]] || {
  printf '%s\n' 'native-desktop-acceptance: FAIL — DISPLAY is required for real desktop acceptance' >&2
  exit 1
}
for command in xdotool import identify compare xclip xmessage xprop xwininfo xdpyinfo rg; do
  command -v "$command" >/dev/null || {
    printf 'native-desktop-acceptance: FAIL — %s is unavailable\n' "$command" >&2
    exit 1
  }
done
"$system_python" -c 'import Xlib' >/dev/null 2>&1 || {
  printf '%s\n' 'native-desktop-acceptance: FAIL — python3-xlib is required for EWMH state normalization' >&2
  exit 1
}

cargo build --release --manifest-path native/Cargo.toml --locked --offline >/dev/null
native_bin="$repo_root/native/target/release/athena-terminal"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT
resize_dump="$tmp_dir/resize-layout.json"
before="$tmp_dir/before.png"
brightness="$tmp_dir/brightness.png"
focus="$tmp_dir/focus.png"
crt="$tmp_dir/crt.png"
focus_lost="$tmp_dir/focus-lost.png"
focus_return="$tmp_dir/focus-return.png"
clipboard_capture="$tmp_dir/clipboard.txt"
clipboard_input="$tmp_dir/clipboard-input.txt"

layout_json="$($native_bin --dump-layout)"
window_strategy="$(LAYOUT_JSON="$layout_json" "$system_python" -c '
import json, os
layout = json.loads(os.environ["LAYOUT_JSON"])
window_management = layout.get("window_management", {})
print(window_management.get("selected_strategy", window_management.get("strategy", "unavailable")))
')"
[[ "$window_strategy" != "unavailable" ]] || {
  printf '%s\n' 'native-desktop-acceptance: FAIL — native layout did not report a window-management strategy' >&2
  exit 1
}
wm_supporting_window="$(xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null || true)"
wm_name=""
if [[ "$wm_supporting_window" =~ 0x[0-9a-fA-F]+ ]]; then
  wm_window="${BASH_REMATCH[0]}"
  wm_name="$(xprop -id "$wm_window" _NET_WM_NAME 2>/dev/null | sed -n 's/.*= "\(.*\)"/\1/p' || true)"
fi
xserver_identity="$(xdpyinfo 2>/dev/null | awk -F': ' '/vendor string:|version number:/ {print $1 "=" $2}' | paste -sd ';' - || true)"
printf 'native-desktop-acceptance: INFO — strategy=%s DISPLAY=%s XDG_SESSION_TYPE=%s WM=%s %s\n' \
  "$window_strategy" "$DISPLAY" "${XDG_SESSION_TYPE:-unknown}" \
  "${wm_supporting_window:-unknown}" "${wm_name:-unknown}" >&2
ATHENA_NATIVE_LAYOUT_DUMP="$resize_dump" \
  "$native_bin" --no-animations --command \
  "IFS= read -r line; printf '%s' \"\$line\" > $(printf '%q' "$clipboard_capture"); sleep 30" \
  >/dev/null 2>&1 &
native_pid=$!
cleanup_native() {
  cleanup_pid() {
    local pid="$1"
    [[ -n "$pid" ]] || return 0
    if kill -0 "$pid" 2>/dev/null; then
      kill -TERM "$pid" 2>/dev/null || true
      for _ in $(seq 1 20); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.05
      done
      kill -KILL "$pid" 2>/dev/null || true
    fi
    wait "$pid" 2>/dev/null || true
  }

  cleanup_pid "${native_pid:-}"
  native_pid=""
  cleanup_pid "${clipboard_pid:-}"
  clipboard_pid=""
  cleanup_pid "${focus_probe_pid:-}"
  focus_probe_pid=""
}
trap 'cleanup_native; rm -rf "$tmp_dir"' EXIT

find_window_for_pid() {
  local candidate candidate_pid
  while read -r candidate; do
    candidate_pid="$(xdotool getwindowpid "$candidate" 2>/dev/null || true)"
    if [[ "$candidate_pid" == "$native_pid" ]]; then
      printf '%s' "$candidate"
      return 0
    fi
  done < <(xdotool search --name 'ATHENA' 2>/dev/null || true)
  return 1
}

focus_window() {
  local target="$1"
  # Window discovery can precede WM viewability by a few event-loop turns.
  # Retry activation/focus rather than letting an asynchronous BadMatch from
  # X_SetInputFocus abort the acceptance lane before it tests the product.
  for _ in $(seq 1 30); do
    if timeout 2s xdotool windowmap "$target" 2>/dev/null \
      && (timeout 2s xdotool windowactivate --sync "$target" 2>/dev/null \
        || timeout 2s xdotool windowfocus --sync "$target" 2>/dev/null); then
      return 0
    fi
    sleep 0.1
  done
  return 1
}

clear_maximize_state() {
  ATHENA_WINDOW_ID="$1" "$system_python" -c '
import os
from Xlib import X, display, protocol

display_conn = display.Display()
root = display_conn.screen().root
window = display_conn.create_resource_object("window", int(os.environ["ATHENA_WINDOW_ID"]))
state = display_conn.intern_atom("_NET_WM_STATE")
vertical = display_conn.intern_atom("_NET_WM_STATE_MAXIMIZED_VERT")
horizontal = display_conn.intern_atom("_NET_WM_STATE_MAXIMIZED_HORZ")
message = protocol.event.ClientMessage(
    window=window,
    client_type=state,
    data=(32, [0, vertical, horizontal, 1, 0]),
)
root.send_event(message, event_mask=X.SubstructureRedirectMask | X.SubstructureNotifyMask)
display_conn.sync()
'
}

cancel_ewmh_moveresize() {
  ATHENA_WINDOW_ID="$1" "$system_python" -c '
import os
from Xlib import X, display, protocol

display_conn = display.Display()
root = display_conn.screen().root
window = display_conn.create_resource_object("window", int(os.environ["ATHENA_WINDOW_ID"]))
moveresize = display_conn.intern_atom("_NET_WM_MOVERESIZE")
message = protocol.event.ClientMessage(
    window=window,
    client_type=moveresize,
    data=(32, [0, 0, 11, 1, 1]),
)
root.send_event(message, event_mask=X.SubstructureRedirectMask | X.SubstructureNotifyMask)
display_conn.sync()
'
}

window_geometry() {
  local geometry
  geometry="$(xdotool getwindowgeometry --shell "$window")"
  window_x="$(awk -F= '$1 == "X" {print $2}' <<< "$geometry")"
  window_y="$(awk -F= '$1 == "Y" {print $2}' <<< "$geometry")"
  window_width="$(awk -F= '$1 == "WIDTH" {print $2}' <<< "$geometry")"
  window_height="$(awk -F= '$1 == "HEIGHT" {print $2}' <<< "$geometry")"
}

capture_window() {
  local output="$1"
  window_geometry
  import -window root \
    -crop "${window_width}x${window_height}+${window_x}+${window_y}" \
    +repage "$output"
}

window=""
for _ in $(seq 1 100); do
  window="$(find_window_for_pid || true)"
  [[ -n "$window" ]] && break
  sleep 0.1
done
[[ -n "$window" ]] || {
  printf '%s\n' 'native-desktop-acceptance: FAIL — Athena window did not appear' >&2
  exit 1
}
focus_window "$window" || {
  printf '%s\n' 'native-desktop-acceptance: FAIL — Athena window could not be focused' >&2
  exit 1
}
clear_maximize_state "$window"
sleep 0.3
sleep 0.3
window_geometry
# The WM may choose a different live size than the deterministic 1280x800
# layout probe. Hit-test coordinates must be derived from the actual surface.
layout_json="$($native_bin --dump-layout --dump-layout-size "${window_width}x${window_height}")"
read -r brightness_x brightness_y focus_x focus_y crt_x crt_y header_x header_y prompt_x prompt_y < <(
  LAYOUT_JSON="$layout_json" "$system_python" -c '
import json, os
layout = json.loads(os.environ["LAYOUT_JSON"])
rail = layout["rail"]
def center(name):
    rect = rail[name]
    return round(rect["x"] + rect["width"] / 2), round(rect["y"] + rect["height"] / 2)
header = layout["header"]
print(*center("brightness"), *center("focus"), *center("power"),
      round(header["x"] + header["width"] / 2),
      round(header["y"] + header["height"] / 2),
      round(layout["prompt"]["x"] + layout["prompt"]["width"] / 2),
      round(layout["prompt"]["y"] + layout["prompt"]["height"] / 2))
'
)
capture_window "$before"
xdotool mousemove --window "$window" "$prompt_x" "$prompt_y"
xdotool click --window "$window" 1

# Clipboard is a real X11 selection round-trip, not only a key-event smoke
# test. The native editor must deliver the selected text to its PTY child.
clipboard_text='real desktop clipboard — Athena'
printf '%s' "$clipboard_text" > "$clipboard_input"
xclip -selection clipboard -in < "$clipboard_input" >/dev/null 2>&1 &
clipboard_pid=$!
xdotool key --window "$window" ctrl+shift+v
sleep 0.25
xdotool key --window "$window" Return
kill "$clipboard_pid" 2>/dev/null || true
wait "$clipboard_pid" 2>/dev/null || true
clipboard_pid=""
for _ in $(seq 1 30); do
  [[ -f "$clipboard_capture" ]] && break
  sleep 0.1
done
[[ -f "$clipboard_capture" && "$(<"$clipboard_capture")" == "$clipboard_text" ]] || {
  printf '%s\n' 'native-desktop-acceptance: FAIL — real X11 clipboard paste did not reach the PTY child' >&2
  exit 1
}

# The borderless fascia attempts EWMH when advertised, but always keeps the
# deterministic client-managed drag armed as an adaptive fallback. A WM that
# advertises and ignores EWMH must therefore still pass this gesture.
window_geometry
original_x="$window_x"
original_y="$window_y"
original_width="$window_width"
original_height="$window_height"
header_drag_verified=0
if [[ "$window_strategy" == "ewmh" ]]; then
  printf '%s\n' 'native-desktop-acceptance: INFO — WM advertises EWMH; exercising adaptive confirmation/fallback' >&2
else
  printf '%s\n' 'native-desktop-acceptance: INFO — WM lacks _NET_WM_MOVERESIZE; using client-managed fallback' >&2
fi
# Exercise the actual application gesture in both modes. When EWMH is
# advertised, the native client attempts it and falls back after the bounded
# confirmation window; when it is absent, the same gesture starts the client
# mover directly. Either adaptive strategy must move the managed surface.
xdotool mousemove --window "$window" "$header_x" "$header_y"
xdotool mousedown --window "$window" 1
xdotool mousemove_relative -- 48 32
xdotool mouseup 1
if [[ "$window_strategy" == "ewmh" ]]; then
  # Some WMs retain the interactive moveresize grab after a synthetic drag
  # release. Direction 11 is the EWMH-defined cancellation message and
  # prevents the next control gesture from moving the whole window.
  cancel_ewmh_moveresize "$window"
fi
sleep 0.2
window_geometry
if [[ "$window_x" == "$original_x" && "$window_y" == "$original_y" \
  && "$window_width" == "$original_width" && "$window_height" == "$original_height" ]]; then
  printf '%s\n' 'native-desktop-acceptance: FAIL — adaptive header move did not change geometry' >&2
  exit 1
else
  header_drag_verified=1
  printf '%s\n' 'native-desktop-acceptance: PASS — header fascia EWMH/adaptive client moveresize' >&2
fi
xdotool windowmove --sync "$window" "$original_x" "$original_y"
sleep 0.1

# Header EWMH moves may snap the surface to the desktop bounds. Restore a
# manageable client geometry before testing controls and edge resizes, then
# refresh every hit-test coordinate against that live geometry.
clear_maximize_state "$window"
sleep 0.3
# A borderless WM may leave the surface at the full work area after an EWMH
# move. Use the canonical supported probe size so the following move and all
# eight edge gestures have room to change geometry on every certified display.
xdotool windowsize --sync "$window" 1280 800
sleep 0.3
window_geometry
layout_json="$($native_bin --dump-layout --dump-layout-size "${window_width}x${window_height}")"
read -r brightness_x brightness_y focus_x focus_y crt_x crt_y header_x header_y prompt_x prompt_y < <(
  LAYOUT_JSON="$layout_json" "$system_python" -c '
import json, os
layout = json.loads(os.environ["LAYOUT_JSON"])
rail = layout["rail"]
def center(name):
    rect = rail[name]
    return round(rect["x"] + rect["width"] / 2), round(rect["y"] + rect["height"] / 2)
header = layout["header"]
print(*center("brightness"), *center("focus"), *center("power"),
      round(header["x"] + header["width"] / 2),
      round(header["y"] + header["height"] / 2),
      round(layout["prompt"]["x"] + layout["prompt"]["width"] / 2),
      round(layout["prompt"]["y"] + layout["prompt"]["height"] / 2))
'
)
capture_window "$before"
capture_width="$window_width"
capture_height="$window_height"
capture_geometry="$(identify -format '%wx%h' "$before")"
[[ "$capture_geometry" != "0x0" && "$capture_geometry" != "" ]] || {
  printf '%s\n' 'native-desktop-acceptance: FAIL — baseline X11 capture has no dimensions' >&2
  exit 1
}

# A managed borderless window must remain movable even when the host desktop
# does not accept synthetic _NET_WM_MOVERESIZE gestures (some remote X11 WMs
# intentionally ignore them). This still proves the supported window-manager
# move contract without masking the header result above.
xdotool windowmove --sync "$window" "$((original_x + 32))" "$((original_y + 24))"
sleep 0.1
window_geometry
[[ "$window_x" != "$original_x" || "$window_y" != "$original_y" ]] || {
  printf '%s\n' 'native-desktop-acceptance: FAIL — managed window move did not change geometry' >&2
  exit 1
}
xdotool windowmove --sync "$window" "$original_x" "$original_y"
sleep 0.1

# Exercise physical controls through X11 mouse input. These controls are
# presentation-only: they must change the frame, never task/PTY authority.
xdotool mousemove --window "$window" "$brightness_x" "$brightness_y"
xdotool mousedown --window "$window" 1
xdotool mousemove --window "$window" "$((brightness_x + 40))" "$brightness_y"
xdotool mouseup 1
sleep 0.15
capture_window "$brightness"
xdotool mousemove --window "$window" "$focus_x" "$focus_y"
xdotool mousedown --window "$window" 1
xdotool mousemove --window "$window" "$((focus_x + 40))" "$focus_y"
xdotool mouseup 1
sleep 0.15
capture_window "$focus"
xdotool mousemove --window "$window" "$crt_x" "$crt_y"
xdotool click --window "$window" 1
sleep 0.15
capture_window "$crt"

for capture in "$brightness" "$focus" "$crt"; do
  [[ "$(identify -format '%wx%h' "$capture")" == "$capture_geometry" ]] || {
    printf 'native-desktop-acceptance: FAIL — unexpected capture dimensions for %s\n' "$capture" >&2
    exit 1
  }
done
brightness_rmse="$(compare -metric RMSE "$before" "$brightness" null: 2>&1 || true)"
focus_rmse="$(compare -metric RMSE "$brightness" "$focus" null: 2>&1 || true)"
crt_rmse="$(compare -metric RMSE "$before" "$crt" null: 2>&1 || true)"
[[ "$brightness_rmse" != *'(0)'* && "$brightness_rmse" != '0'* ]] || {
  printf '%s\n' 'native-desktop-acceptance: FAIL — brightness/focus controls produced no frame change' >&2
  exit 1
}
[[ "$focus_rmse" != *'(0)'* && "$focus_rmse" != '0'* ]] || {
  printf '%s\n' 'native-desktop-acceptance: FAIL — focus drag produced no frame change' >&2
  exit 1
}
[[ "$crt_rmse" != *'(0)'* && "$crt_rmse" != '0'* ]] || {
  printf '%s\n' 'native-desktop-acceptance: FAIL — CRT control produced no frame change' >&2
  exit 1
}

# Focus loss/return must be handled by the native event loop and must not
# terminate the PTY session. Use a real second X11 client as the focus peer.
xmessage -name ATHENA_FOCUS_PROBE 'Athena focus probe' >/dev/null 2>&1 &
focus_probe_pid=$!
focus_probe=""
for _ in $(seq 1 50); do
  focus_probe="$(xdotool search --name 'ATHENA_FOCUS_PROBE' 2>/dev/null | head -1 || true)"
  [[ -n "$focus_probe" ]] && break
  sleep 0.1
done
[[ -n "$focus_probe" ]] || {
  kill "$focus_probe_pid" 2>/dev/null || true
  printf '%s\n' 'native-desktop-acceptance: FAIL — focus probe window did not appear' >&2
  exit 1
}
focus_window "$focus_probe" || {
  printf '%s\n' 'native-desktop-acceptance: FAIL — focus probe window could not be focused' >&2
  exit 1
}
sleep 0.2
capture_window "$focus_lost"
focus_window "$window" || {
  printf '%s\n' 'native-desktop-acceptance: FAIL — Athena focus could not be restored' >&2
  exit 1
}
sleep 0.2
capture_window "$focus_return"
kill "$focus_probe_pid" 2>/dev/null || true
wait "$focus_probe_pid" 2>/dev/null || true
focus_probe_pid=""
focus_lost_rmse="$(compare -metric RMSE "$before" "$focus_lost" null: 2>&1 || true)"
focus_return_rmse="$(compare -metric RMSE "$focus_lost" "$focus_return" null: 2>&1 || true)"
[[ "$focus_lost_rmse" != *'(0)'* && "$focus_lost_rmse" != '0'* ]] || {
  printf '%s\n' 'native-desktop-acceptance: FAIL — focus loss produced no native frame change' >&2
  exit 1
}
[[ "$focus_return_rmse" != *'(0)'* && "$focus_return_rmse" != '0'* ]] || {
  printf '%s\n' 'native-desktop-acceptance: FAIL — focus return produced no native frame change' >&2
  exit 1
}

# Exercise the native perimeter's eight EWMH resize directions. The expected
# sign is asserted rather than an exact pixel delta because WMs may apply
# resize increments or minimum-size hints.
for resize_case in \
  'top-left - -' \
  'top 0 -' \
  'top-right 1 -' \
  'right 1 0' \
  'bottom-right 1 1' \
  'bottom 0 1' \
  'bottom-left - 1' \
  'left - 0'; do
  read -r resize_name width_sign height_sign <<< "$resize_case"
  xdotool windowsize --sync "$window" "$capture_width" "$capture_height"
  sleep 0.1
  window_geometry
  resize_before_width="$window_width"
  resize_before_height="$window_height"
  case "$resize_name" in
    top-left) resize_x=2; resize_y=2 ;;
    top) resize_x=$((window_width / 2)); resize_y=2 ;;
    top-right) resize_x=$((window_width - 2)); resize_y=2 ;;
    right) resize_x=$((window_width - 2)); resize_y=$((window_height / 2)) ;;
    bottom-right) resize_x=$((window_width - 2)); resize_y=$((window_height - 2)) ;;
    bottom) resize_x=$((window_width / 2)); resize_y=$((window_height - 2)) ;;
    bottom-left) resize_x=2; resize_y=$((window_height - 2)) ;;
    left) resize_x=2; resize_y=$((window_height / 2)) ;;
  esac
  xdotool mousemove --sync --window "$window" "$resize_x" "$resize_y"
  # Let the WM observe the edge position before the synthetic press. This is
  # important after the preceding EWMH gesture moved the pointer itself.
  sleep 0.1
  xdotool mousedown --window "$window" 1
  sleep 0.1
  case "$resize_name" in
    top-left|top-right) xdotool mousemove_relative -- 24 24 ;;
    top) xdotool mousemove_relative -- 0 24 ;;
    right) xdotool mousemove_relative -- 24 0 ;;
    bottom-right) xdotool mousemove_relative -- 24 24 ;;
    bottom) xdotool mousemove_relative -- 0 24 ;;
    bottom-left) xdotool mousemove_relative -- 24 24 ;;
    left) xdotool mousemove_relative -- 24 0 ;;
  esac
  xdotool mouseup 1
  sleep 0.2
  window_geometry
  if [[ "$width_sign" == '1' && "$window_width" -le "$resize_before_width" ]] \
    || [[ "$width_sign" == '-' && "$window_width" -ge "$resize_before_width" ]] \
    || [[ "$height_sign" == '1' && "$window_height" -le "$resize_before_height" ]] \
    || [[ "$height_sign" == '-' && "$window_height" -ge "$resize_before_height" ]]; then
    printf 'native-desktop-acceptance: FAIL — %s resize direction was not honored\n' "$resize_name" >&2
    exit 1
  fi
  if [[ "$window_strategy" == "ewmh" ]]; then
    cancel_ewmh_moveresize "$window"
  fi
done

# Unmap/remap exercises the supported managed-window lifecycle without losing
# the native process or the PTY child. EWMH minimize is WM policy, so it is
# deliberately not treated as an Athena product invariant.
window_is_viewable() {
  xwininfo -id "$1" 2>/dev/null | rg -q 'Map State: IsViewable'
}

xdotool windowsize --sync "$window" "$capture_width" "$capture_height"
xdotool windowunmap "$window"
sleep 0.25
if window_is_viewable "$window"; then
  printf '%s\n' 'native-desktop-acceptance: FAIL — native surface remained visible after unmap' >&2
  exit 1
fi
xdotool windowmap --sync "$window"
focus_window "$window" || {
  printf '%s\n' 'native-desktop-acceptance: FAIL — Athena window could not be refocused after remap' >&2
  exit 1
}
sleep 0.2
window_is_viewable "$window" || {
  printf '%s\n' 'native-desktop-acceptance: FAIL — native window did not restore after remap' >&2
  exit 1
}

# Exercise live ConfigureNotify handling at several real window sizes.
for size in "${capture_width}x${capture_height}" 1170x659 1920x1080; do
  IFS=x read -r resize_width resize_height <<< "$size"
  xdotool windowsize --sync "$window" "$resize_width" "$resize_height"
  sleep 0.2
  "$repo_root/scripts/check-native-layout.py" "$resize_dump" "$resize_width" "$resize_height"
done

# WM_DELETE_WINDOW must close the surface cleanly after controls and resizes.
xdotool windowclose "$window"
for _ in $(seq 1 100); do
if ! kill -0 "$native_pid" 2>/dev/null; then
    wait "$native_pid"
    if [[ "$header_drag_verified" == "1" ]]; then
      write_desktop_receipt "ewmh-confirmed-or-client-fallback"
      printf '%s\n' 'native-desktop-acceptance: PASS — live X11 controls, clipboard, focus, header moveresize, eight-way resize, unmap/remap, CRT, and close'
    else
      write_desktop_receipt "client-managed-fallback"
      printf '%s\n' 'native-desktop-acceptance: PASS — live X11 controls, clipboard, focus, generic window move, unmap/remap, CRT, and close (desktop fallback; not release evidence)'
    fi
    exit 0
  fi
  sleep 0.1
done
printf '%s\n' 'native-desktop-acceptance: FAIL — WM close did not terminate native process' >&2
exit 1
