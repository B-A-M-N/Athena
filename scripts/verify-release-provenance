#!/usr/bin/env python3
"""Verify release provenance with the same library used by receipt checks."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT / "src"))

from athena.release.provenance import (  # noqa: E402
    ProvenanceVerificationError,
    verify_provenance,
)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("provenance", type=Path)
    parser.add_argument("signature", type=Path)
    parser.add_argument("--certificate", type=Path, default=None)
    parser.add_argument("--metadata", type=Path, default=None)
    args = parser.parse_args(argv)
    try:
        record = verify_provenance(
            args.provenance,
            args.signature,
            certificate=args.certificate,
        )
    except ProvenanceVerificationError as exc:
        print(f"verify-release-provenance: FAIL — {exc}", file=sys.stderr)
        return 1
    if args.metadata is not None:
        args.metadata.parent.mkdir(parents=True, exist_ok=True)
        args.metadata.write_text(
            json.dumps(record, indent=2, sort_keys=True) + "\n", encoding="utf-8"
        )
    print("verify-release-provenance: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
