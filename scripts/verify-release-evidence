#!/usr/bin/env python3
"""Verify the exact certified release artifacts before publication."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import sys
import tomllib

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT / "src"))

from athena.release.provenance import (  # noqa: E402
    ProvenanceVerificationError,
    verify_provenance,
)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def fail(message: str) -> int:
    print(f"verify-release-evidence: FAIL {message}", file=sys.stderr)
    return 1


CERTIFICATION_EXCLUDED = {
    "release-certification-manifest.json",
    "release-certification.sig",
    "release-certification.crt",
    "release-certification-verification.json",
    "release-provenance-verification.json",
}


def _load_release_policy() -> dict[str, object]:
    path = REPO_ROOT / "scripts" / "release-policy-v1.json"
    value = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(value, dict):
        raise ValueError("release policy is not an object")
    return value


def _check_certification_root(
    evidence: Path,
    *,
    commit_sha: str,
    release_run_id: str,
) -> str | None:
    manifest_path = evidence / "release-certification-manifest.json"
    signature_path = evidence / "release-certification.sig"
    certificate_path = evidence / "release-certification.crt"
    verification_path = evidence / "release-certification-verification.json"
    if (
        not manifest_path.is_file()
        or not signature_path.is_file()
        or not signature_path.stat().st_size
    ):
        return "releasable evidence has no certification-root signature"
    if not verification_path.is_file():
        return "certification-root verification record is missing"
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
        verification = json.loads(verification_path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        return f"invalid certification root: {exc}"
    try:
        verified = verify_provenance(
            manifest_path,
            signature_path,
            certificate=certificate_path if certificate_path.is_file() else None,
        )
    except ProvenanceVerificationError as exc:
        return str(exc)
    if not isinstance(verification, dict) or verification.get("status") != "PASS":
        return "certification-root verification record is not a PASS"
    for key in ("mechanism", "cosign_version", "signer_identity", "oidc_issuer", "key_fingerprint"):
        if verification.get(key) != verified.get(key):
            return f"certification-root verification metadata mismatch: {key}"
    if (
        not isinstance(manifest, dict)
        or manifest.get("kind") != "athena_release_certification_manifest"
        or manifest.get("schema_version") != 1
        or manifest.get("source_sha") != commit_sha
        or manifest.get("release_run_id") != release_run_id
        or not isinstance(manifest.get("files"), list)
    ):
        return "certification-root manifest is not bound to the certified release"
    expected: dict[str, tuple[str, int]] = {}
    for item in manifest["files"]:
        if not isinstance(item, dict) or not isinstance(item.get("path"), str):
            return "certification-root file record is malformed"
        relative = Path(item["path"])
        if (
            relative.is_absolute()
            or ".." in relative.parts
            or relative.as_posix() in CERTIFICATION_EXCLUDED
        ):
            return f"certification-root contains an invalid path: {item['path']}"
        digest = item.get("sha256")
        size = item.get("size")
        if not isinstance(digest, str) or len(digest) != 64 or not isinstance(size, int):
            return f"certification-root file record is incomplete: {item['path']}"
        if relative.as_posix() in expected:
            return f"certification-root contains a duplicate path: {item['path']}"
        expected[relative.as_posix()] = (digest, size)
    actual: dict[str, tuple[str, int]] = {}
    for path in evidence.rglob("*"):
        if not path.is_file():
            continue
        relative = path.relative_to(evidence).as_posix()
        if relative in CERTIFICATION_EXCLUDED:
            continue
        actual[relative] = (sha256(path), path.stat().st_size)
    if expected != actual:
        return "certification-root does not cover the exact evidence tree"
    return None


def _check_release_lanes(result: dict[str, object]) -> str | None:
    try:
        policy = _load_release_policy()
    except (OSError, ValueError, TypeError) as exc:
        return f"cannot load release lane policy: {exc}"
    if result.get("release_policy") != policy.get("policy_version"):
        return "final result does not identify the configured release lane policy"
    mandatory = policy.get("mandatory_lanes")
    allowed_extra = policy.get("allowed_extra_lanes")
    if not isinstance(mandatory, list) or not all(isinstance(name, str) for name in mandatory):
        return "release lane policy is malformed"
    if not isinstance(allowed_extra, list) or not all(
        isinstance(name, str) for name in allowed_extra
    ):
        return "release lane policy extras are malformed"
    lanes = result.get("lanes")
    if not isinstance(lanes, list):
        return "final result lanes are not a list"
    names: list[str] = []
    for lane in lanes:
        if not isinstance(lane, dict) or not isinstance(lane.get("name"), str):
            return "final result contains a malformed lane record"
        name = lane["name"]
        if name in names:
            return f"release lane appears more than once: {name}"
        names.append(name)
        if name not in mandatory and name not in allowed_extra:
            return f"release lane is not allowed by policy: {name}"
        if type(lane.get("exit_code")) is not int or lane.get("exit_code") != 0:
            return f"release lane did not pass: {name}"
    missing = [name for name in mandatory if name not in names]
    if missing:
        return "release result is missing mandatory lanes: " + ", ".join(missing)
    return None


def _check_identity(
    value: object,
    *,
    label: str,
    commit_sha: str,
    release_run_id: str,
    source_key: str = "commit_sha",
) -> str | None:
    """Return an error when one machine-readable record crosses runs."""
    if not isinstance(value, dict):
        return f"{label} is not a JSON object"
    if value.get(source_key) != commit_sha:
        return f"{label} {source_key} does not match certified SHA"
    if value.get("release_run_id") != release_run_id:
        return f"{label} release run does not match certified run"
    return None


def _check_records(
    values: object,
    *,
    label: str,
    commit_sha: str,
    release_run_id: str,
) -> str | None:
    if not isinstance(values, list):
        return f"{label} is not a record list"
    for index, value in enumerate(values):
        error = _check_identity(
            value,
            label=f"{label}[{index}]",
            commit_sha=commit_sha,
            release_run_id=release_run_id,
        )
        if error:
            return error
        if value.get("exit_code") != 0:
            return f"{label}[{index}] did not pass"
    return None


def _evidence_location(root: Path, sha: str, run_id: str | None) -> Path | None:
    """Resolve a published ``<sha>/<run-id>`` transaction.

    Flat evidence remains readable for older certified records and unit
    fixtures. New release-check output is always nested and must be selected
    explicitly when a root contains more than one run.
    """
    if (root / "final-release-result.json").is_file():
        return root
    sha_root = root / sha
    if run_id:
        candidate = sha_root / run_id
        return candidate if candidate.is_dir() else None
    candidates = (
        sorted(
            path for path in sha_root.iterdir() if path.is_dir() and not path.name.startswith(".")
        )
        if sha_root.is_dir()
        else []
    )
    return candidates[0] if len(candidates) == 1 else None


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--evidence-dir", required=True, type=Path)
    parser.add_argument("--sha", required=True)
    parser.add_argument("--tag", required=True)
    parser.add_argument(
        "--run-id",
        default=None,
        help="published release run id when --evidence-dir is an evidence root",
    )
    args = parser.parse_args(argv)

    evidence_root = args.evidence_dir.resolve()
    evidence = _evidence_location(evidence_root, args.sha, args.run_id)
    if evidence is None:
        return fail("evidence root does not contain one complete commit/run transaction")
    result_path = evidence / "final-release-result.json"
    manifest_path = evidence / "release-manifest.json"
    identity_path = evidence / "release-identity.json"
    artifact_dir = evidence / "distributions"
    required_json = (
        result_path,
        manifest_path,
        identity_path,
        evidence / "optional-integrations.json",
        evidence / "static-checks.json",
        evidence / "pytest-summary.json",
        evidence / "release-scenarios.json",
        evidence / "backend-passport.json",
        evidence / "toolchain-passport.json",
        evidence / "support-matrix.json",
        evidence / "release-sbom.spdx.json",
        evidence / "rust-supply-chain.json",
        evidence / "cargo-deny-bootstrap.json",
        evidence / "release-provenance-verification.json",
        evidence / "release-certification-manifest.json",
        evidence / "release-certification-verification.json",
    )
    for path in required_json:
        if not path.is_file():
            return fail(f"missing evidence file {path.name}")
    if not artifact_dir.is_dir():
        return fail("missing distributions directory")

    try:
        result = json.loads(result_path.read_text(encoding="utf-8"))
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
        identity = json.loads(identity_path.read_text(encoding="utf-8"))
        optional_integrations = json.loads(
            (evidence / "optional-integrations.json").read_text(encoding="utf-8")
        )
        static_checks = json.loads((evidence / "static-checks.json").read_text(encoding="utf-8"))
        pytest_summary = json.loads((evidence / "pytest-summary.json").read_text(encoding="utf-8"))
        scenarios = json.loads((evidence / "release-scenarios.json").read_text(encoding="utf-8"))
        backend_passport = json.loads(
            (evidence / "backend-passport.json").read_text(encoding="utf-8")
        )
        toolchain_passport = json.loads(
            (evidence / "toolchain-passport.json").read_text(encoding="utf-8")
        )
        support_matrix = json.loads((evidence / "support-matrix.json").read_text(encoding="utf-8"))
        sbom = json.loads((evidence / "release-sbom.spdx.json").read_text(encoding="utf-8"))
        rust_supply_chain = json.loads(
            (evidence / "rust-supply-chain.json").read_text(encoding="utf-8")
        )
        cargo_deny_bootstrap = json.loads(
            (evidence / "cargo-deny-bootstrap.json").read_text(encoding="utf-8")
        )
    except (OSError, ValueError) as exc:
        return fail(f"invalid evidence JSON: {exc}")

    identity_error = _check_identity(
        identity,
        label="identity",
        commit_sha=args.sha,
        release_run_id=str(identity.get("release_run_id", "")),
    )
    release_run_id = identity.get("release_run_id")
    if not isinstance(release_run_id, str) or not release_run_id:
        return fail("identity is missing an exact release run id")
    if args.run_id and release_run_id != args.run_id:
        return fail("identity release run does not match requested run")
    if identity_error:
        return fail(identity_error)

    if result.get("status") != "PASS" or result.get("releasable") is not True:
        return fail("protected release result is not a releasable PASS")
    lane_error = _check_release_lanes(result)
    if lane_error:
        return fail(lane_error)
    if identity.get("release_policy") != result.get("release_policy"):
        return fail("release identity and final result use different release policies")
    certification_error = _check_certification_root(
        evidence,
        commit_sha=args.sha,
        release_run_id=release_run_id,
    )
    if certification_error:
        return fail(certification_error)
    provenance_path = evidence / "release-provenance.json"
    signature_path = evidence / "release-provenance.sig"
    certificate_path = evidence / "release-provenance.crt"
    verification_path = evidence / "release-provenance-verification.json"
    if (
        not provenance_path.is_file()
        or not signature_path.is_file()
        or not signature_path.stat().st_size
    ):
        return fail("releasable evidence has no signed release provenance payload")
    try:
        provenance = json.loads(provenance_path.read_text(encoding="utf-8"))
        verification = json.loads(verification_path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        return fail(f"invalid release provenance: {exc}")
    try:
        verified = verify_provenance(
            provenance_path,
            signature_path,
            certificate=certificate_path if certificate_path.is_file() else None,
        )
    except ProvenanceVerificationError as exc:
        return fail(str(exc))
    if not isinstance(verification, dict) or verification.get("status") != "PASS":
        return fail("release provenance verification record is not a PASS")
    for key in ("mechanism", "cosign_version", "signer_identity", "oidc_issuer", "key_fingerprint"):
        if verification.get(key) != verified.get(key):
            return fail(f"release provenance verification metadata mismatch: {key}")
    if not isinstance(provenance, dict):
        return fail("release provenance is not an object")
    if provenance.get("kind") != "athena_release_provenance":
        return fail("release provenance kind is invalid")
    if provenance.get("source_sha") != args.sha:
        return fail("release provenance source does not match certified SHA")
    if provenance.get("release_run_id") != release_run_id:
        return fail("release provenance run does not match certified run")
    if provenance.get("manifest_sha256") != sha256(manifest_path):
        return fail("release provenance manifest hash does not match evidence")
    provenance_artifacts = provenance.get("artifacts")
    if not isinstance(provenance_artifacts, list) or not provenance_artifacts:
        return fail("release provenance has no artifact hashes")
    for item in provenance_artifacts:
        if not isinstance(item, dict) or not isinstance(item.get("path"), str):
            return fail("release provenance artifact record is malformed")
        artifact = evidence / item["path"]
        if not artifact.is_file() or sha256(artifact) != item.get("sha256"):
            return fail(f"release provenance artifact hash mismatch: {item.get('path')}")
    actual_provenance_paths = {
        f"distributions/{path.relative_to(artifact_dir).as_posix()}"
        for path in artifact_dir.rglob("*")
        if path.is_file()
    }
    if {str(item.get("path")) for item in provenance_artifacts} != actual_provenance_paths:
        return fail("release provenance does not cover exactly the certified distributions")
    if result.get("commit_sha") != args.sha:
        return fail("result commit does not match certified SHA")
    if result.get("release_run_id") != release_run_id:
        return fail("result release run does not match certified run")
    passport_error = _check_identity(
        backend_passport,
        label="backend passport",
        commit_sha=args.sha,
        release_run_id=release_run_id,
        source_key="release_sha",
    )
    if passport_error:
        return fail(passport_error)
    if (
        backend_passport.get("kind") != "athena_backend_passport"
        or backend_passport.get("status") != "PASS"
        or not isinstance(backend_passport.get("cells"), list)
        or not backend_passport["cells"]
    ):
        return fail("backend passport is not a complete PASS")
    for index, cell in enumerate(backend_passport["cells"]):
        if not isinstance(cell, dict) or cell.get("passed") is not True:
            return fail(f"backend passport cell [{index}] did not pass")
        if cell.get("unverified_claims"):
            return fail(f"backend passport cell [{index}] has unverified claims")
    if (
        not isinstance(toolchain_passport, dict)
        or toolchain_passport.get("kind") != "athena_toolchain_passport"
        or toolchain_passport.get("status") != "PASS"
        or toolchain_passport.get("release_sha") != args.sha
        or toolchain_passport.get("release_run_id") != release_run_id
    ):
        return fail("toolchain passport is not a bound PASS")
    if toolchain_passport.get("policy_errors") != [] or not isinstance(
        toolchain_passport.get("policy"), dict
    ):
        return fail("toolchain passport does not prove the configured toolchain policy")
    lock_hashes = toolchain_passport.get("lock_hashes")
    if (
        not isinstance(lock_hashes, dict)
        or lock_hashes.get("cargo_lock_sha256") != manifest.get("cargo_lock_sha256")
        or lock_hashes.get("uv_lock_sha256") != manifest.get("uv_lock_sha256")
    ):
        return fail("toolchain passport lock hashes do not match the release manifest")
    if (
        not isinstance(rust_supply_chain, dict)
        or rust_supply_chain.get("status") != "PASS"
        or rust_supply_chain.get("source_sha") != args.sha
        or rust_supply_chain.get("release_run_id") != release_run_id
        or not isinstance(cargo_deny_bootstrap, dict)
        or cargo_deny_bootstrap.get("status") != "PASS"
        or cargo_deny_bootstrap.get("version") != "0.20.2"
    ):
        return fail("Rust supply-chain/bootstrap evidence is not a bound PASS")
    if not isinstance(support_matrix, dict):
        return fail("generated support matrix is not an object")
    matrix_binding = support_matrix.get("release_binding")
    generated_from = support_matrix.get("generated_from")
    behavioral_evidence = (
        generated_from.get("behavioral_evidence") if isinstance(generated_from, dict) else None
    )
    passport_evidence = (
        behavioral_evidence.get("backend_passport")
        if isinstance(behavioral_evidence, dict)
        else None
    )
    if (
        support_matrix.get("generated_by") != "scripts/generate-support-matrix"
        or matrix_binding != {"source_sha": args.sha, "release_run_id": release_run_id}
        or not isinstance(generated_from, dict)
        or generated_from.get("release_sha") != args.sha
        or generated_from.get("release_run_id") != release_run_id
        or not isinstance(passport_evidence, dict)
        or passport_evidence.get("status") != "PASS"
    ):
        return fail("generated support matrix is not bound to the certified backend passport")
    surfaces = support_matrix.get("surfaces")
    if not isinstance(surfaces, dict) or not surfaces:
        return fail("generated support matrix has no surfaces")
    for name, surface in surfaces.items():
        proof = surface.get("proof") if isinstance(surface, dict) else None
        if (
            not isinstance(surface, dict)
            or surface.get("implementation_status") not in {"implemented", "partial"}
            or surface.get("certification_status") != "certified"
            or not isinstance(surface.get("certified_versions"), list)
            or not surface.get("certified_versions")
            or not isinstance(surface.get("certified_platforms"), list)
            or not surface.get("certified_platforms")
            or not isinstance(surface.get("evidence_lane"), list)
            or not surface.get("evidence_lane")
            or not isinstance(surface.get("evidence_receipt"), dict)
            or surface["evidence_receipt"].get("source_sha") != args.sha
            or surface["evidence_receipt"].get("release_run_id") != release_run_id
            or surface["evidence_receipt"].get("status") != "PASS"
            or not isinstance(proof, dict)
            or proof.get("status") != "certified"
            or not proof.get("evidence")
        ):
            return fail(f"support surface {name} is not certified by executable evidence")
    if manifest.get("source_sha") != args.sha:
        return fail("manifest source does not match certified SHA")
    if manifest.get("release_run_id") != release_run_id:
        return fail("artifact manifest release run does not match certified run")
    if identity.get("commit_sha") != args.sha:
        return fail("identity commit does not match certified SHA")
    if identity.get("skip_e2e") is not False:
        return fail("certified evidence skipped installed-artifact acceptance")
    if identity.get("include_endurance") is not True:
        return fail("releasable evidence must include the mandatory beta endurance lane")
    endurance_path = evidence / "endurance-receipt.json"
    if not endurance_path.is_file():
        return fail("mandatory endurance receipt is missing")
    try:
        endurance = json.loads(endurance_path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        return fail(f"invalid endurance receipt: {exc}")
    try:
        endurance_duration = float(endurance.get("duration_hours") or 0)
    except (AttributeError, TypeError, ValueError):
        endurance_duration = 0.0
    if (
        not isinstance(endurance, dict)
        or endurance.get("kind") != "athena_endurance_receipt"
        or endurance.get("status") != "PASS"
        or endurance.get("source_sha") != args.sha
        or endurance.get("release_run_id") != release_run_id
        or endurance_duration < 0.5
    ):
        return fail("endurance receipt is not a bound 30-minute PASS")
    if manifest.get("source_status") != "frozen-clean":
        return fail("artifact manifest does not identify a frozen clean source")
    sbom_record = manifest.get("sbom")
    if not isinstance(sbom_record, dict):
        return fail("artifact manifest has no SBOM record")
    if sbom_record.get("path") != "release-sbom.spdx.json":
        return fail("artifact manifest SBOM path is not the certified evidence file")
    sbom_binding = sbom.get("athenaBinding")
    if not isinstance(sbom_binding, dict):
        return fail("SBOM has no Athena source binding")
    if sbom_binding.get("source_sha") != args.sha:
        return fail("SBOM source binding does not match certified SHA")
    if sbom_binding.get("cargo_lock_sha256") != manifest.get("cargo_lock_sha256"):
        return fail("SBOM Cargo.lock binding does not match manifest")
    if sbom_binding.get("uv_lock_sha256") != manifest.get("uv_lock_sha256"):
        return fail("SBOM uv.lock binding does not match manifest")
    packages = sbom.get("packages")
    python_packages = (
        [
            package
            for package in packages
            if isinstance(package, dict)
            and str(package.get("SPDXID", "")).startswith("SPDXRef-Python-")
        ]
        if isinstance(packages, list)
        else []
    )
    if not python_packages or sbom_record.get("python_package_count") != len(python_packages):
        return fail("SBOM does not enumerate the locked Python dependency set")
    native_packages = (
        [
            package
            for package in packages
            if isinstance(package, dict)
            and package.get("SPDXID") == "SPDXRef-AthenaNativeDistribution"
        ]
        if isinstance(packages, list)
        else []
    )
    if len(native_packages) != 1 or sbom_record.get("native_distribution_count") != 1:
        return fail("SBOM does not enumerate the native companion distribution")
    for package in [*python_packages, *native_packages]:
        license_declared = package.get("licenseDeclared")
        license_metadata = package.get("athena_license_metadata")
        if not isinstance(license_declared, str) or not license_declared.strip():
            return fail(f"SBOM package has no license declaration: {package.get('name')}")
        if not isinstance(license_metadata, dict) or not isinstance(
            license_metadata.get("source"), str
        ):
            return fail(f"SBOM package has no license provenance: {package.get('name')}")
        if (
            not isinstance(package.get("downloadLocation"), str)
            or not package["downloadLocation"].strip()
        ):
            return fail(f"SBOM package has no source location: {package.get('name')}")
    allowed_scopes = {"project", "python-runtime-direct", "python-transitive"}
    for package in python_packages:
        scope = package.get("athena_dependency_scope")
        if not isinstance(scope, str) or not (
            scope in allowed_scopes or scope.startswith("python-optional-direct:")
        ):
            return fail(
                f"SBOM Python package has an invalid dependency scope: {package.get('name')}"
            )
    uv_lock_path = REPO_ROOT / "uv.lock"
    if uv_lock_path.is_file() and sha256(uv_lock_path) == manifest.get("uv_lock_sha256"):
        try:
            uv_lock = tomllib.loads(uv_lock_path.read_text(encoding="utf-8"))
            expected_python = {
                (str(item.get("name")), str(item.get("version")))
                for item in uv_lock.get("package", [])
                if isinstance(item, dict)
            }
            actual_python = {
                (str(item.get("name")), str(item.get("versionInfo"))) for item in python_packages
            }
        except (OSError, ValueError, TypeError) as exc:
            return fail(f"cannot inspect the locked Python dependency set: {exc}")
        if actual_python != expected_python:
            return fail("SBOM Python components differ from uv.lock")
        expected_project = "athena-agent"
        locked_packages = {
            (str(item.get("name")), str(item.get("version"))): item
            for item in uv_lock.get("package", [])
            if isinstance(item, dict)
        }
        for package in python_packages:
            name = str(package.get("name"))
            if name == expected_project:
                if package.get("athena_dependency_scope") != "project":
                    return fail("SBOM Athena project package has the wrong scope")
                continue
            checksums = package.get("checksums")
            if not isinstance(checksums, list) or not any(
                isinstance(item, dict)
                and item.get("algorithm") == "SHA256"
                and isinstance(item.get("checksumValue"), str)
                and len(item["checksumValue"]) == 64
                for item in checksums
            ):
                return fail(f"SBOM Python package has no lock checksum: {name}")
            locked = locked_packages.get((name, str(package.get("versionInfo"))), {})
            expected_hashes = set()
            sdist = locked.get("sdist")
            if isinstance(sdist, dict) and isinstance(sdist.get("hash"), str):
                expected_hashes.add(sdist["hash"].removeprefix("sha256:"))
            for wheel in locked.get("wheels", []) or []:
                if isinstance(wheel, dict) and isinstance(wheel.get("hash"), str):
                    expected_hashes.add(wheel["hash"].removeprefix("sha256:"))
            recorded_hashes = {
                str(item.get("checksumValue"))
                for item in checksums
                if isinstance(item, dict) and item.get("algorithm") == "SHA256"
            }
            if expected_hashes.isdisjoint(recorded_hashes):
                return fail(f"SBOM Python package checksum is not present in uv.lock: {name}")
    native_artifact_path = native_packages[0].get("athena_artifact_path")
    native_checksums = native_packages[0].get("checksums")
    if isinstance(native_artifact_path, str) and isinstance(native_checksums, list):
        native_artifact = evidence / native_artifact_path
        expected_native_sha = next(
            (
                item.get("checksumValue")
                for item in native_checksums
                if isinstance(item, dict) and item.get("algorithm") == "SHA256"
            ),
            None,
        )
        if (
            not native_artifact.is_file()
            or not isinstance(expected_native_sha, str)
            or sha256(native_artifact) != expected_native_sha
        ):
            return fail("SBOM native companion checksum does not match its artifact")
    if sha256(evidence / "release-sbom.spdx.json") != sbom_record.get("sha256"):
        return fail("SBOM SHA-256 does not match the artifact manifest")

    for label, payload in (
        ("optional integrations", optional_integrations),
        ("static checks", static_checks),
        ("pytest summary", pytest_summary),
        ("scenario manifest", scenarios),
    ):
        error = _check_identity(
            payload,
            label=label,
            commit_sha=args.sha,
            release_run_id=release_run_id,
        )
        if error:
            return fail(error)

    error = _check_identity(
        result,
        label="final result",
        commit_sha=args.sha,
        release_run_id=release_run_id,
    )
    if error:
        return fail(error)
    error = _check_identity(
        manifest,
        label="artifact manifest",
        commit_sha=args.sha,
        release_run_id=release_run_id,
        source_key="source_sha",
    )
    if error:
        return fail(error)
    error = _check_records(
        result.get("lanes"),
        label="final lanes",
        commit_sha=args.sha,
        release_run_id=release_run_id,
    )
    if error:
        return fail(error)
    if not result.get("lanes"):
        return fail("final result has no lane records")
    error = _check_records(
        static_checks.get("lanes"),
        label="static lanes",
        commit_sha=args.sha,
        release_run_id=release_run_id,
    )
    if error:
        return fail(error)
    if not static_checks.get("lanes"):
        return fail("static checks have no lane records")
    desktop_lane = next(
        (
            lane
            for lane in result.get("lanes", [])
            if lane.get("name") == "native-desktop-acceptance"
        ),
        None,
    )
    if isinstance(desktop_lane, dict) and int(desktop_lane.get("exit_code") or 0) == 0:
        desktop_path = evidence / "native-desktop-acceptance.json"
        if not desktop_path.is_file():
            return fail("desktop acceptance PASS has no native desktop receipt")
        try:
            desktop = json.loads(desktop_path.read_text(encoding="utf-8"))
        except (OSError, ValueError) as exc:
            return fail(f"invalid native desktop receipt: {exc}")
        if (
            not isinstance(desktop, dict)
            or desktop.get("kind") != "athena_native_desktop_receipt"
            or desktop.get("status") != "PASS"
            or desktop.get("source_sha") != args.sha
            or desktop.get("release_run_id") != release_run_id
            or not desktop.get("display")
            or not desktop.get("session_type")
            or not desktop.get("wm")
            or not desktop.get("xserver")
            or not desktop.get("window_strategy")
            or "active_strategy" not in desktop
            or "fallback_reason" not in desktop
        ):
            return fail("native desktop receipt lacks a complete X11/WM environment identity")
    error = _check_identity(
        pytest_summary.get("lane"),
        label="pytest lane",
        commit_sha=args.sha,
        release_run_id=release_run_id,
    )
    if error:
        return fail(error)
    if pytest_summary.get("lane") is None:
        return fail("pytest summary has no lane record")

    scenario_entries = scenarios.get("scenarios")
    if not isinstance(scenario_entries, list) or not scenario_entries:
        return fail("scenario manifest has no scenario records")
    for index, scenario in enumerate(scenario_entries):
        if not isinstance(scenario, dict):
            return fail(f"scenario manifest record [{index}] is malformed")
        error = _check_identity(
            scenario,
            label=f"scenario manifest record [{index}]",
            commit_sha=args.sha,
            release_run_id=release_run_id,
        )
        if error:
            return fail(error)
        source_identity = scenario.get("source_identity")
        if not isinstance(source_identity, dict):
            return fail(f"scenario manifest record [{index}] has no source identity")
        if source_identity.get("head_sha") != args.sha:
            return fail(f"scenario manifest record [{index}] source SHA does not match")
        if source_identity.get("release_run_id") != release_run_id:
            return fail(f"scenario manifest record [{index}] release run does not match")
        error = _check_records(
            scenario.get("evidence"),
            label=f"scenario records[{index}].evidence",
            commit_sha=args.sha,
            release_run_id=release_run_id,
        )
        if error:
            return fail(error)

    source_identity = scenarios.get("source_identity")
    if not isinstance(source_identity, dict):
        return fail("scenario manifest has no source identity")
    if source_identity.get("head_sha") != args.sha:
        return fail("scenario manifest source SHA does not match")
    if source_identity.get("release_run_id") != release_run_id:
        return fail("scenario manifest source run does not match")
    summary = scenarios.get("summary")
    if not isinstance(summary, dict) or summary.get("required_not_passed"):
        return fail("scenario manifest has required scenarios that did not pass")

    hermes = optional_integrations.get("hermes_referee")
    if not isinstance(hermes, dict):
        return fail("optional integrations has no Hermes record")
    if hermes.get("source_sha") != args.sha or hermes.get("release_run_id") != release_run_id:
        return fail("optional Hermes record does not match certified commit/run")

    tag_version = args.tag.removeprefix("v")
    if tag_version != manifest.get("python_version"):
        return fail("release tag does not match the certified Python version")

    entries = manifest.get("artifacts")
    if not isinstance(entries, list) or not entries:
        return fail("artifact manifest has no publishable artifacts")
    expected_names: set[str] = set()
    for entry in entries:
        if not isinstance(entry, dict):
            return fail("artifact manifest contains a malformed entry")
        source_path = Path(str(entry.get("path", "")))
        if source_path.parent != Path("distributions"):
            return fail(f"artifact is outside distributions boundary: {source_path}")
        source_name = source_path.name
        if source_name in expected_names or not source_name.endswith((".whl", ".tar.gz")):
            return fail(f"invalid or duplicate artifact name {source_name!r}")
        if entry.get("commit_sha") != args.sha or entry.get("release_run_id") != release_run_id:
            return fail(f"artifact record does not match certified commit/run: {source_name}")
        expected_names.add(source_name)
        path = artifact_dir / source_name
        if not path.is_file():
            return fail(f"missing certified artifact {source_name}")
        if path.stat().st_size != entry.get("size"):
            return fail(f"size mismatch for {source_name}")
        if sha256(path) != entry.get("sha256"):
            return fail(f"SHA-256 mismatch for {source_name}")

    actual_entries = list(artifact_dir.iterdir())
    if any(not path.is_file() for path in actual_entries):
        return fail("distributions directory contains a non-file entry")
    actual_names = {path.name for path in actual_entries}
    if actual_names != expected_names:
        return fail("downloaded artifacts differ from the certified manifest")
    if any("native" in name for name in expected_names):
        abi = manifest.get("native_abi_policy")
        if not isinstance(abi, dict) or abi.get("status") != "PASS":
            return fail("native artifact is missing a passing ABI policy result")
    print(f"verify-release-evidence: PASS {args.sha} {manifest['python_version']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
