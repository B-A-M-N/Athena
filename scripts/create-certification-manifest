#!/usr/bin/env python3
"""Create the signed root manifest for one complete release evidence tree."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import sys


EXCLUDED = {
    "release-certification-manifest.json",
    "release-certification.sig",
    "release-certification.crt",
    "release-certification-verification.json",
    "release-provenance-verification.json",
}


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--evidence-dir", type=Path, required=True)
    parser.add_argument("--source-sha", required=True)
    parser.add_argument("--release-run-id", required=True)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args(argv)

    evidence = args.evidence_dir.resolve()
    if not evidence.is_dir():
        print(
            "create-certification-manifest: FAIL — evidence directory is missing", file=sys.stderr
        )
        return 1
    source_manifest = evidence / "source-tree-manifest.json"
    try:
        source_manifest_record = json.loads(source_manifest.read_text(encoding="utf-8"))
        source_tree_digest = source_manifest_record["tree_sha256"]
    except (KeyError, OSError, TypeError, ValueError):
        print(
            "create-certification-manifest: FAIL — canonical source manifest is missing or invalid",
            file=sys.stderr,
        )
        return 1
    if source_manifest_record.get("source_sha") not in {None, args.source_sha}:
        print(
            "create-certification-manifest: FAIL — source manifest SHA does not match certification",
            file=sys.stderr,
        )
        return 1
    if not source_tree_digest:
        print(
            "create-certification-manifest: FAIL — canonical source tree digest is missing",
            file=sys.stderr,
        )
        return 1
    files = []
    for path in sorted(item for item in evidence.rglob("*") if item.is_file()):
        relative = path.relative_to(evidence).as_posix()
        if relative in EXCLUDED:
            continue
        files.append({"path": relative, "sha256": sha256(path), "size": path.stat().st_size})
    if not files:
        print("create-certification-manifest: FAIL — evidence tree is empty", file=sys.stderr)
        return 1
    record = {
        "kind": "athena_release_certification_manifest",
        "schema_version": 1,
        "source_sha": args.source_sha,
        "source_tree_digest": source_tree_digest,
        "release_run_id": args.release_run_id,
        "files": files,
    }
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(record, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(f"create-certification-manifest: PASS — {args.output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
