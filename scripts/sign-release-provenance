#!/usr/bin/env bash
set -euo pipefail

# Signing is an explicit release operation. This command never emits a
# placeholder signature: a release host must provide cosign and a keyless
# identity or a configured key.
input="${1:-}"
output="${2:-}"
[[ -n "$input" && -f "$input" ]] || { printf '%s\n' 'sign-release-provenance: usage: sign-release-provenance PROVENANCE.json SIGNATURE' >&2; exit 2; }
[[ -n "$output" ]] || { printf '%s\n' 'sign-release-provenance: output signature is required' >&2; exit 2; }
cosign_bin="${ATHENA_COSIGN:-${COSIGN_BIN:-$(command -v cosign || true)}}"
[[ -n "$cosign_bin" ]] || {
  printf '%s\n' 'sign-release-provenance: FAIL — cosign is required; no unsigned fallback' >&2
  exit 1
}

if [[ -n "${COSIGN_KEY:-}" ]]; then
  "$cosign_bin" sign-blob --yes --key "$COSIGN_KEY" --output-signature "$output" "$input"
else
  certificate="${output%.sig}.crt"
  "$cosign_bin" sign-blob --yes \
    --output-signature "$output" \
    --output-certificate "$certificate" \
    "$input"
  [[ -s "$certificate" ]] || {
    printf '%s\n' 'sign-release-provenance: FAIL — keyless cosign produced no certificate' >&2
    exit 1
  }
fi
[[ -s "$output" ]] || { printf '%s\n' 'sign-release-provenance: FAIL — cosign produced no signature' >&2; exit 1; }
printf 'sign-release-provenance: PASS — %s\n' "$output"
