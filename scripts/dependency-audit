#!/usr/bin/env python3
"""Audit all locked runtime and optional dependencies for known advisories."""

from __future__ import annotations

import os
from pathlib import Path
import subprocess
import tempfile


def main() -> int:
    repo_root = Path(__file__).resolve().parent.parent
    uv = os.environ.get("ATHENA_RELEASE_UV", "uv")
    with tempfile.TemporaryDirectory(prefix="athena-dependency-audit-") as temporary:
        requirements = Path(temporary) / "requirements.txt"
        subprocess.run(
            [
                uv,
                "export",
                "--frozen",
                "--all-extras",
                "--format",
                "requirements.txt",
                "--no-emit-project",
                "--output-file",
                str(requirements),
            ],
            cwd=repo_root,
            check=True,
            stdout=subprocess.DEVNULL,
        )
        completed = subprocess.run(
            [
                "pip-audit",
                "-r",
                str(requirements),
                "--disable-pip",
                "--progress-spinner",
                "off",
            ],
            cwd=repo_root,
            check=False,
        )
        return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main())
