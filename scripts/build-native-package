#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
export UV_CACHE_DIR="${UV_CACHE_DIR:-/tmp/athena-uv-cache}"
# This script is also invoked directly by the release lane before the main
# distribution build.  ``--no-sync`` can leave the shared release venv empty,
# so provision the declared locked build dependency here as well.
build_python=("${ATHENA_RELEASE_UV:-uv}" run --frozen --extra dev python)

output_dir="dist"
if [[ "${1:-}" == "--output-dir" ]]; then
  [[ -n "${2:-}" ]] || {
    printf '%s\n' 'build-native-package: --output-dir needs a path' >&2
    exit 2
  }
  output_dir="$2"
fi
mkdir -p "$output_dir"
tmp_dir="$(mktemp -d -t athena-native-package.XXXXXX)"
trap 'rm -rf "$tmp_dir"' EXIT

cargo build --release --manifest-path native/Cargo.toml --locked --offline
cp -R native/package "$tmp_dir/package"
cp native/target/release/athena-terminal "$tmp_dir/package/athena_native/athena-terminal"
chmod 0755 "$tmp_dir/package/athena_native/athena-terminal"
"${build_python[@]}" -m build --no-isolation --wheel --outdir "$output_dir" "$tmp_dir/package"
printf '%s\n' "native-package: built companion wheel in $output_dir"
