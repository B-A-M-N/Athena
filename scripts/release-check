#!/usr/bin/env python3
"""Run the release gate against one frozen, clean commit.

The developer checkout may be dirty while work is in progress.  This command
does not pretend that such a checkout is a release candidate: it extracts one
resolved commit into a temporary clean tree and runs every release lane there.
    Pass ``--evidence-dir`` when the lane records must survive the temporary tree;
    records are published transactionally under ``<root>/<commit-sha>/<run-id>``.

Usage::

    scripts/release-check                 # check HEAD as a clean commit
    scripts/release-check --sha <commit>  # check an exact release candidate
    scripts/release-check --bootstrap     # provision pinned cargo-deny, fetch deps, then check offline
    scripts/release-check --skip-e2e      # local fast gate; not the full gate
    scripts/release-check --sha <commit> --evidence-dir .release-evidence
"""

from __future__ import annotations

import argparse
import io
import json
import os
import signal
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import tarfile
import time
import uuid


REPO_ROOT = Path(__file__).resolve().parent.parent
# The beta endurance profile is itself wall-clock bounded at 30 minutes. Give
# its final pytest teardown and receipt flush a finite margin without making
# every other release lane wait longer after a hang.
ENDURANCE_TIMEOUT_SECONDS = 2100.0
sys.path.insert(0, str(REPO_ROOT / "src"))

from athena.release.gates import (  # noqa: E402
    RELEASE_POLICY_VERSION,
    lane_stage,
    release_commands,
)


def _git(*args: str, cwd: Path = REPO_ROOT) -> str:
    result = subprocess.run(
        ["git", *args],
        cwd=cwd,
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    return result.stdout.strip()


def _run(
    command: list[str],
    *,
    cwd: Path,
    env: dict[str, str],
    timeout: float,
) -> dict[str, object]:
    print(f"[release] {' '.join(command)}", flush=True)
    started = time.monotonic()
    popen_kwargs: dict[str, object] = {}
    if os.name == "posix":
        # Every lane gets its own session so a timeout cannot leave a compiler,
        # test worker, or descendant server behind in the release host.
        popen_kwargs["start_new_session"] = True
    try:
        process = subprocess.Popen(
            command,
            cwd=cwd,
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            **popen_kwargs,
        )
        try:
            output, _ = process.communicate(timeout=timeout)
            exit_code = process.returncode
        except subprocess.TimeoutExpired as exc:
            output = exc.output or ""
            if isinstance(output, bytes):
                output = output.decode("utf-8", "replace")
            group_id = process.pid
            if os.name == "posix":
                for sig in (signal.SIGTERM, signal.SIGKILL):
                    try:
                        os.killpg(group_id, sig)
                    except ProcessLookupError:
                        break
                    try:
                        process.wait(timeout=2.0)
                        break
                    except subprocess.TimeoutExpired:
                        continue
            else:
                process.terminate()
                try:
                    process.wait(timeout=2.0)
                except subprocess.TimeoutExpired:
                    process.kill()
            tail, _ = process.communicate()
            output += tail or ""
            output += f"\ncommand timed out after {timeout:g}s"
            if _process_group_alive(group_id):
                output += "\nrelease-check: descendant process survived timeout cleanup"
                exit_code = 125
            else:
                exit_code = 124
    except OSError as exc:
        output = f"{type(exc).__name__}: {exc}"
        exit_code = 127
    print(output, end="" if output.endswith("\n") else "\n", flush=True)
    return {
        "command": command,
        "exit_code": exit_code,
        "duration_s": round(time.monotonic() - started, 3),
        "output": output,
    }


def _process_group_alive(group_id: int) -> bool:
    """Return true when a timed-out lane still has a live process group."""
    if os.name != "posix":
        return False
    try:
        os.killpg(group_id, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def _run_static_concurrently(
    lanes_to_run: list[tuple[str, list[str]]],
    *,
    cwd: Path,
    env: dict[str, str],
    timeout: float,
) -> list[dict[str, object]]:
    """Run the static stage's lanes concurrently.

    Every static lane is a read-only source check (ruff/mypy/compileall/audit/
    lint) on the same frozen tree: no shared writable state, no timing
    sensitivity. They are also the cheapest full-machine-CPU lanes, so the
    20-core box otherwise idles through them serially. Results keep the
    original lane order regardless of completion order, so downstream
    evidence and failure reporting stay deterministic.
    """
    import concurrent.futures

    results: dict[str, dict[str, object]] = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=min(6, len(lanes_to_run))) as pool:
        futures = {
            pool.submit(_run, command, cwd=cwd, env=env, timeout=timeout): name
            for name, command in lanes_to_run
        }
        for future in concurrent.futures.as_completed(futures):
            results[futures[future]] = future.result()
    ordered = []
    for name, _ in lanes_to_run:
        record = results[name]
        record["name"] = name
        ordered.append(record)
    return ordered


def _extract_commit(commit: str, checkout: Path, *, timeout: float) -> None:
    """Extract one commit without writing repository metadata.

    The release check must also work in read-only CI/agent environments where
    ``.git/worktrees`` cannot be created.  ``git archive`` gives us the same
    committed bytes while keeping the source checkout untouched.
    """
    try:
        archive = subprocess.run(
            ["git", "archive", "--format=tar", commit],
            cwd=REPO_ROOT,
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
        ).stdout
    except subprocess.TimeoutExpired as exc:
        raise RuntimeError("timed out while extracting the frozen commit") from exc
    checkout.mkdir(parents=True, exist_ok=True)
    with tarfile.open(fileobj=io.BytesIO(archive), mode="r:") as tar:
        root = checkout.resolve()
        members = []
        for member in tar.getmembers():
            target = (checkout / member.name).resolve()
            if target != root and root not in target.parents:
                raise RuntimeError(f"frozen archive contains unsafe path: {member.name}")
            members.append(member)
        tar.extractall(checkout, members=members)


def _write_json(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.tmp")
    temporary.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
    os.replace(temporary, path)


def _write_text(path: Path, value: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.tmp")
    temporary.write_text(value)
    os.replace(temporary, path)


def _evidence_record(record: dict[str, object]) -> dict[str, object]:
    return {key: value for key, value in record.items() if key != "output"} | {
        "output_tail": str(record.get("output") or "")[-4000:]
    }


def _release_run_id() -> str:
    """Choose a stable CI run id or generate one for local certification."""
    value = os.environ.get("ATHENA_RELEASE_RUN_ID") or os.environ.get("GITHUB_RUN_ID")
    if value:
        value = value.strip()
        if value and all(char.isalnum() or char in {"-", "_"} for char in value):
            return value
    return uuid.uuid4().hex


def _certify_evidence(
    evidence: Path,
    *,
    checkout: Path,
    env: dict[str, str],
    uv: str,
    source_sha: str,
    release_run_id: str,
    timeout: float,
) -> None:
    """Create and cryptographically verify the root over final evidence."""
    create = _run(
        [
            uv,
            "run",
            "--frozen",
            "--extra",
            "dev",
            "python",
            "scripts/create-certification-manifest",
            "--evidence-dir",
            str(evidence),
            "--source-sha",
            source_sha,
            "--release-run-id",
            release_run_id,
            "--output",
            str(evidence / "release-certification-manifest.json"),
        ],
        cwd=checkout,
        env=env,
        timeout=timeout,
    )
    if int(create.get("exit_code") or 0) != 0:
        raise RuntimeError("certification manifest creation failed")
    sign = _run(
        [
            "scripts/sign-release-provenance",
            str(evidence / "release-certification-manifest.json"),
            str(evidence / "release-certification.sig"),
        ],
        cwd=checkout,
        env=env,
        timeout=timeout,
    )
    if int(sign.get("exit_code") or 0) != 0:
        raise RuntimeError("certification manifest signing failed")
    verify_command = [
        uv,
        "run",
        "--frozen",
        "--extra",
        "dev",
        "python",
        "scripts/verify-release-provenance",
        str(evidence / "release-certification-manifest.json"),
        str(evidence / "release-certification.sig"),
        "--metadata",
        str(evidence / "release-certification-verification.json"),
    ]
    certificate = evidence / "release-certification.crt"
    if certificate.is_file():
        verify_command.extend(["--certificate", str(certificate)])
    verify = _run(verify_command, cwd=checkout, env=env, timeout=timeout)
    if int(verify.get("exit_code") or 0) != 0:
        raise RuntimeError("certification manifest failed cryptographic verification")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="scripts/release-check",
        description="Run the complete release gate against a frozen commit.",
    )
    parser.add_argument(
        "--sha",
        default=None,
        help="commit-ish to check (resolved once before creating the worktree)",
    )
    parser.add_argument(
        "--uv",
        default=os.environ.get("ATHENA_RELEASE_UV", "uv"),
        help="uv executable used for Python lanes",
    )
    parser.add_argument(
        "--timeout",
        type=float,
        default=1800.0,
        help="per-command timeout in seconds (default: %(default)s)",
    )
    parser.add_argument(
        "--skip-e2e",
        action="store_true",
        help="skip installed-artifact acceptance; not a full release check",
    )
    parser.add_argument(
        "--stage",
        default=None,
        choices=["static", "tests", "bench", "integration"],
        help=(
            "run only one gate stage (static | tests | bench | integration); "
            "default runs every lane. A stage run records partial evidence "
            "and is not by itself a release verdict."
        ),
    )
    parser.add_argument(
        "--include-hermes-live",
        action="store_true",
        help="include optional operator-owned Hermes live evidence",
    )
    parser.add_argument(
        "--include-endurance",
        action="store_true",
        default=True,
        help="include the real 30-minute beta endurance lane",
    )
    parser.add_argument(
        "--skip-endurance",
        action="store_false",
        dest="include_endurance",
        help="skip beta endurance; the resulting evidence is not releasable",
    )
    parser.add_argument(
        "--bootstrap",
        action="store_true",
        help="provision pinned cargo-deny and fetch locked Rust dependencies before offline checks",
    )
    parser.add_argument(
        "--defer-signing",
        action="store_true",
        help="leave signing to the isolated release signer job after evidence upload",
    )
    parser.add_argument(
        "--evidence-dir",
        default=None,
        help="directory outside the temporary checkout for durable release evidence",
    )
    args = parser.parse_args(argv)
    if args.timeout <= 0:
        parser.error("--timeout must be positive")
    if args.skip_e2e and args.include_hermes_live:
        parser.error("--include-hermes-live requires the full gate (omit --skip-e2e)")
    if args.stage is None and not args.skip_e2e and not args.evidence_dir:
        parser.error("--evidence-dir is required for a full signed release qualification")

    explicit_sha = args.sha is not None
    requested_sha = args.sha or "HEAD"
    if not explicit_sha:
        try:
            dirty = _git("status", "--porcelain", "--untracked-files=all")
        except (OSError, subprocess.CalledProcessError) as exc:
            print(f"release-check: cannot inspect checkout state: {exc}", file=sys.stderr)
            return 2
        if dirty:
            print(
                "release-check: FAIL working tree contains changes not represented "
                "by HEAD; commit the candidate or pass --sha explicitly",
                file=sys.stderr,
            )
            return 1

    try:
        resolved = _git("rev-parse", "--verify", f"{requested_sha}^{{commit}}")
    except (OSError, subprocess.CalledProcessError) as exc:
        print(f"release-check: cannot resolve --sha {requested_sha!r}: {exc}", file=sys.stderr)
        return 2

    temp_root = Path(tempfile.mkdtemp(prefix="athena-release-check-"))
    checkout = temp_root / "checkout"
    evidence_root = Path(args.evidence_dir).expanduser().resolve() if args.evidence_dir else None
    run_id = _release_run_id()
    evidence_dir = evidence_root / resolved / run_id if evidence_root is not None else None
    evidence_stage: Path | None = None
    if evidence_root is not None:
        evidence_root.mkdir(parents=True, exist_ok=True)
        evidence_stage = Path(tempfile.mkdtemp(prefix=f".{run_id}.", dir=evidence_root))
    lanes: list[dict[str, object]] = []
    final_status = "FAIL"
    error: str | None = None
    release_env: dict[str, str] | None = None
    source_manifest_path: Path | None = None
    source_tree_digest: str | None = None
    certification_failure: str | None = None
    try:
        if evidence_dir is not None:
            _write_json(
                evidence_stage / "release-identity.json",
                {
                    "commit_sha": resolved,
                    "release_run_id": run_id,
                    "requested_sha": requested_sha,
                    "explicit_sha": explicit_sha,
                    "skip_e2e": bool(args.skip_e2e),
                    "stage": args.stage,
                    "include_hermes_live": bool(args.include_hermes_live),
                    "include_endurance": bool(args.include_endurance),
                    "optional_integrations": {
                        "hermes_referee": {
                            "required_for_core_release": False,
                            "commit_sha": resolved,
                            "release_run_id": run_id,
                            "status": (
                                "pending_live_certification"
                                if args.include_hermes_live
                                else "not_certified_live"
                            ),
                        }
                    },
                    "bootstrap": bool(args.bootstrap),
                    "defer_signing": bool(args.defer_signing),
                    "release_policy": RELEASE_POLICY_VERSION,
                },
            )
        _extract_commit(resolved, checkout, timeout=args.timeout)
        env = dict(os.environ)
        release_env = env
        source_manifest_path = temp_root / "source-tree-manifest.json"
        source_manifest_record = _run(
            [
                sys.executable,
                str(checkout / "scripts/source-manifest"),
                "--root",
                str(checkout),
                "--output",
                str(source_manifest_path),
                "--source-sha",
                resolved,
            ],
            cwd=checkout,
            env=env,
            timeout=args.timeout,
        )
        source_manifest_record.update(
            {"name": "frozen-source-manifest", "commit_sha": resolved, "release_run_id": run_id}
        )
        lanes.append(source_manifest_record)
        if int(source_manifest_record.get("exit_code") or 0) != 0:
            raise RuntimeError("frozen source manifest creation failed")
        source_manifest = json.loads(source_manifest_path.read_text(encoding="utf-8"))
        source_tree_digest = str(source_manifest.get("tree_sha256") or "")
        if not source_tree_digest:
            raise RuntimeError("frozen source manifest has no canonical tree digest")
        if evidence_dir is not None:
            shutil.copy2(source_manifest_path, evidence_stage / source_manifest_path.name)
        env["PYTHONPATH"] = str(checkout / "src") + (
            os.pathsep + env["PYTHONPATH"] if env.get("PYTHONPATH") else ""
        )
        env.pop("PYTHONHOME", None)
        env.pop("VIRTUAL_ENV", None)
        env["ATHENA_RELEASE_SHA"] = resolved
        env["ATHENA_RELEASE_RUN_ID"] = run_id
        env["ATHENA_FROZEN_SOURCE"] = "1"
        env["ATHENA_FROZEN_SOURCE_MANIFEST"] = str(source_manifest_path)
        env["ATHENA_SOURCE_TREE_DIGEST"] = source_tree_digest
        env["ATHENA_RELEASE_GATE"] = "1"
        if args.include_hermes_live:
            env["ATHENA_HERMES_INTEGRATION_GATE"] = "1"
        else:
            env.pop("ATHENA_HERMES_INTEGRATION_GATE", None)
        env["ATHENA_RELEASE_UV"] = args.uv
        env["ATHENA_SUPPLY_CHAIN_EVIDENCE_DIR"] = str(
            evidence_stage if evidence_stage is not None else checkout / "release-evidence"
        )
        # Keep uv's environment outside the checkout. Otherwise the first
        # ``uv run`` can create an untracked .venv and make the later
        # scenarios --require-clean assertion fail for the wrong reason.
        env["UV_PROJECT_ENVIRONMENT"] = str(temp_root / "venv")
        env["UV_CACHE_DIR"] = str(temp_root / "uv-cache")
        resolved_uv = shutil.which(args.uv) or args.uv
        if not Path(resolved_uv).is_file():
            raise RuntimeError(f"configured uv executable is unavailable: {args.uv}")
        args.uv = str(Path(resolved_uv).resolve())
        env["ATHENA_RELEASE_UV"] = args.uv
        toolchain_bin = temp_root / "toolchain-bin"
        toolchain_bin.mkdir()
        for tool in ("cargo", "rustc"):
            resolved_tool = shutil.which(tool)
            if not resolved_tool:
                raise RuntimeError(f"required toolchain executable is unavailable: {tool}")
            (toolchain_bin / tool).symlink_to(Path(resolved_tool).resolve())
        env["PATH"] = str(toolchain_bin) + os.pathsep + env.get("PATH", "")
        cosign_configured = env.get("ATHENA_COSIGN") or env.get("COSIGN_BIN")
        resolved_cosign = (
            shutil.which(cosign_configured) if cosign_configured else shutil.which("cosign")
        )
        if resolved_cosign:
            env["ATHENA_COSIGN"] = str(Path(resolved_cosign).resolve())
        resolved_system_python = shutil.which("python3")
        if resolved_system_python:
            env["ATHENA_RELEASE_SYSTEM_PYTHON"] = str(Path(resolved_system_python).resolve())
        if args.bootstrap:
            cargo_deny_root = temp_root / "cargo-deny"
            cargo_deny_receipt = temp_root / "cargo-deny-bootstrap.json"
            bootstrap_command = [
                "scripts/bootstrap-cargo-deny",
                "--output-dir",
                str(cargo_deny_root),
            ]
            bootstrap_record = _run(
                bootstrap_command,
                cwd=checkout,
                env={**env, "ATHENA_CARGO_DENY_RECEIPT": str(cargo_deny_receipt)},
                timeout=args.timeout,
            )
            bootstrap_record.update(
                {
                    "name": "cargo-deny-bootstrap",
                    "commit_sha": resolved,
                    "release_run_id": run_id,
                }
            )
            lanes.append(bootstrap_record)
            if int(bootstrap_record.get("exit_code") or 0) != 0:
                raise RuntimeError(
                    "cargo-deny bootstrap failed: " + str(bootstrap_record.get("output") or "")
                )
            env["ATHENA_CARGO_DENY_BIN"] = str(cargo_deny_root / "bin" / "cargo-deny")
            if evidence_dir is not None and cargo_deny_receipt.is_file():
                shutil.copy2(cargo_deny_receipt, evidence_stage / cargo_deny_receipt.name)
        lanes_to_run = release_commands(
            args.uv,
            skip_e2e=args.skip_e2e,
            bootstrap=args.bootstrap,
            include_hermes_live=args.include_hermes_live,
            include_endurance=args.include_endurance,
            stage=args.stage,
        )
        static_lanes = [
            (name, command) for name, command in lanes_to_run if lane_stage(name) == "static"
        ]
        if len(static_lanes) > 1:
            static_records = _run_static_concurrently(
                static_lanes, cwd=checkout, env=env, timeout=args.timeout
            )
            static_by_name = {str(rec.get("name")): rec for rec in static_records}
        else:
            static_by_name = {}
        for name, command in lanes_to_run:
            if name == "support-matrix-release":
                _write_json(
                    checkout / "release-lane-results.json",
                    {
                        "commit_sha": resolved,
                        "release_run_id": run_id,
                        "lanes": [_evidence_record(item) for item in lanes],
                    },
                )
            if name in static_by_name:
                record = static_by_name[name]
            else:
                if name == "release-artifacts":
                    verify_record = _run(
                        [
                            sys.executable,
                            str(checkout / "scripts/source-manifest"),
                            "--root",
                            str(checkout),
                            "--verify",
                            str(source_manifest_path),
                            "--source-sha",
                            resolved,
                        ],
                        cwd=checkout,
                        env=env,
                        timeout=args.timeout,
                    )
                    verify_record.update(
                        {
                            "name": "frozen-source-verify",
                            "commit_sha": resolved,
                            "release_run_id": run_id,
                        }
                    )
                    lanes.append(verify_record)
                    if int(verify_record.get("exit_code") or 0) != 0:
                        raise RuntimeError("frozen source tree changed before artifact packaging")
                command_timeout = (
                    max(args.timeout, ENDURANCE_TIMEOUT_SECONDS)
                    if name == "endurance"
                    else args.timeout
                )
                record = _run(command, cwd=checkout, env=env, timeout=command_timeout)
            record["name"] = name
            record["commit_sha"] = resolved
            record["release_run_id"] = run_id
            lanes.append(record)
            if name == "release-artifacts" and int(record.get("exit_code") or 0) == 0:
                manifest_path = checkout / "release-artifacts" / "release-manifest.json"
                if not manifest_path.is_file():
                    raise RuntimeError("release artifact manifest was not produced")
                manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
                if manifest.get("source_sha") != resolved:
                    raise RuntimeError(
                        "release artifact manifest source_sha does not match frozen commit"
                    )
                if manifest.get("source_tree_digest") != source_tree_digest:
                    raise RuntimeError(
                        "release artifact manifest source_tree_digest does not match frozen source"
                    )
                if evidence_dir is not None:
                    manifest["release_run_id"] = run_id
                    _write_text(
                        evidence_stage / "release-manifest.json",
                        json.dumps(manifest, indent=2, sort_keys=True) + "\n",
                    )
                    sbom = manifest.get("sbom")
                    if not isinstance(sbom, dict) or not sbom.get("path"):
                        raise RuntimeError("release artifact manifest has no SBOM record")
                    sbom_source = checkout / "release-artifacts" / str(sbom["path"])
                    if not sbom_source.is_file():
                        raise RuntimeError("release artifact manifest SBOM file is missing")
                    shutil.copy2(sbom_source, evidence_stage / sbom_source.name)
                    artifact_evidence = evidence_stage / "distributions"
                    if artifact_evidence.exists():
                        raise RuntimeError(
                            "release distributions evidence path already exists; "
                            "use a fresh --evidence-dir"
                        )
                    shutil.copytree(
                        checkout / "release-artifacts" / "distributions",
                        artifact_evidence,
                    )
            if name == "backend-passport" and int(record.get("exit_code") or 0) == 0:
                passport_path = checkout / "backend-passport.json"
                if not passport_path.is_file():
                    raise RuntimeError(
                        "backend passport lane did not produce backend-passport.json"
                    )
                try:
                    passport = json.loads(passport_path.read_text(encoding="utf-8"))
                except (OSError, ValueError) as exc:
                    raise RuntimeError(f"backend passport is not valid JSON: {exc}") from exc
                if (
                    passport.get("kind") != "athena_backend_passport"
                    or passport.get("release_sha") != resolved
                    or passport.get("release_run_id") != run_id
                    or passport.get("status") != "PASS"
                ):
                    raise RuntimeError(
                        "backend passport is not a PASS bound to the frozen SHA and release run"
                    )
                if evidence_dir is not None:
                    _write_text(
                        evidence_stage / "backend-passport.json",
                        json.dumps(passport, indent=2, sort_keys=True) + "\n",
                    )
            if name == "toolchain-passport" and int(record.get("exit_code") or 0) == 0:
                passport_path = checkout / "toolchain-passport.json"
                if not passport_path.is_file():
                    raise RuntimeError(
                        "toolchain passport lane did not produce toolchain-passport.json"
                    )
                if evidence_dir is not None:
                    shutil.copy2(passport_path, evidence_stage / passport_path.name)
            if name == "endurance" and int(record.get("exit_code") or 0) == 0:
                receipt_path = checkout / "endurance-receipt.json"
                if not receipt_path.is_file():
                    raise RuntimeError("endurance lane did not produce endurance-receipt.json")
                if evidence_dir is not None:
                    shutil.copy2(receipt_path, evidence_stage / "endurance-receipt.json")
            if name == "support-matrix-release" and int(record.get("exit_code") or 0) == 0:
                matrix_path = checkout / "release-support-matrix.json"
                if not matrix_path.is_file():
                    raise RuntimeError(
                        "support-matrix release lane did not produce release-support-matrix.json"
                    )
                if evidence_dir is not None:
                    shutil.copy2(matrix_path, evidence_stage / "support-matrix.json")
            if name == "native-desktop-acceptance" and int(record.get("exit_code") or 0) == 0:
                desktop_receipt = checkout / "native-desktop-acceptance.json"
                if not desktop_receipt.is_file():
                    raise RuntimeError(
                        "desktop acceptance lane did not produce native-desktop-acceptance.json"
                    )
                if evidence_dir is not None:
                    shutil.copy2(desktop_receipt, evidence_stage / desktop_receipt.name)
            if evidence_dir is not None:
                _write_text(
                    evidence_stage
                    / {
                        "architecture-lint": "architecture-lint.txt",
                        "native-check": "native-check.txt",
                        "native-test": "native-test.txt",
                        "native-smoke": "native-smoke.txt",
                        "e2e": "e2e.txt",
                    }.get(name, f"{name}.txt"),
                    str(record.get("output") or ""),
                )
            if int(record.get("exit_code") or 0) != 0:
                raise RuntimeError(
                    f"command failed with exit {record['exit_code']}: {' '.join(command)}"
                )
        if evidence_dir is not None:
            hermes_lane = next(
                (item for item in lanes if item.get("name") == "hermes-live"),
                None,
            )
            hermes_status = (
                "PASS"
                if hermes_lane is not None and int(hermes_lane.get("exit_code") or 0) == 0
                else "FAIL"
                if args.include_hermes_live
                else "not_certified_live"
            )
            optional_integrations = {
                "commit_sha": resolved,
                "release_run_id": run_id,
                "hermes_referee": {
                    "required_for_core_release": False,
                    "source_sha": resolved,
                    "commit_sha": resolved,
                    "release_run_id": run_id,
                    "status": hermes_status,
                },
            }
            _write_json(evidence_stage / "optional-integrations.json", optional_integrations)
            static_names = {
                "ruff-format",
                "ruff-check",
                "mypy",
                "compileall",
                "dependency-audit",
                "rust-supply-chain",
                "static-critical",
                "support-matrix",
                "architecture-lint",
                "uv-lock-check",
                "migration-baseline",
            }
            _write_json(
                evidence_stage / "static-checks.json",
                {
                    "commit_sha": resolved,
                    "release_run_id": run_id,
                    "lanes": [
                        _evidence_record(item) for item in lanes if item.get("name") in static_names
                    ],
                },
            )
            pytest_lane = next(
                (item for item in lanes if item.get("name") == "pytest"),
                None,
            )
            _write_json(
                evidence_stage / "pytest-summary.json",
                {
                    "commit_sha": resolved,
                    "release_run_id": run_id,
                    "lane": _evidence_record(pytest_lane) if pytest_lane else None,
                },
            )
            scenario_path = checkout / "release-scenarios.json"
            if scenario_path.exists():
                scenario_manifest = json.loads(scenario_path.read_text(encoding="utf-8"))
                scenario_manifest["commit_sha"] = resolved
                scenario_manifest["release_run_id"] = run_id
                _write_text(
                    evidence_stage / "release-scenarios.json",
                    json.dumps(scenario_manifest, indent=2, sort_keys=True) + "\n",
                )
            else:
                scenario_lane = next(
                    (item for item in lanes if item.get("name") == "release-scenarios"),
                    None,
                )
                _write_json(
                    evidence_stage / "release-scenarios.json",
                    {
                        "commit_sha": resolved,
                        "release_run_id": run_id,
                        "lane": _evidence_record(scenario_lane) if scenario_lane else None,
                    },
                )
            if args.skip_e2e:
                _write_text(
                    evidence_stage / "e2e.txt",
                    "SKIPPED: installed-artifact acceptance was explicitly omitted\n",
                )
            if args.stage is None and not args.skip_e2e:
                provenance_commands = [
                    (
                        "release-provenance",
                        [
                            args.uv,
                            "run",
                            "--frozen",
                            "--extra",
                            "dev",
                            "python",
                            "scripts/create-release-provenance",
                            "--manifest",
                            str(evidence_stage / "release-manifest.json"),
                            "--artifacts",
                            str(evidence_stage / "distributions"),
                            "--output",
                            str(evidence_stage / "release-provenance.json"),
                        ],
                    )
                ]
                if not args.defer_signing:
                    provenance_commands.append(
                        (
                            "release-provenance-signature",
                            [
                                "scripts/sign-release-provenance",
                                str(evidence_stage / "release-provenance.json"),
                                str(evidence_stage / "release-provenance.sig"),
                            ],
                        )
                    )
                for name, command in provenance_commands:
                    record = _run(command, cwd=checkout, env=env, timeout=args.timeout)
                    record["name"] = name
                    record["commit_sha"] = resolved
                    record["release_run_id"] = run_id
                    lanes.append(record)
                    if int(record.get("exit_code") or 0) != 0:
                        raise RuntimeError(
                            f"command failed with exit {record['exit_code']}: {' '.join(command)}"
                        )
                    if name == "release-provenance-signature":
                        verification_command = [
                            args.uv,
                            "run",
                            "--frozen",
                            "--extra",
                            "dev",
                            "python",
                            "scripts/verify-release-provenance",
                            str(evidence_stage / "release-provenance.json"),
                            str(evidence_stage / "release-provenance.sig"),
                            "--metadata",
                            str(evidence_stage / "release-provenance-verification.json"),
                        ]
                        certificate = evidence_stage / "release-provenance.crt"
                        if certificate.is_file():
                            verification_command.extend(["--certificate", str(certificate)])
                        record = _run(
                            verification_command,
                            cwd=checkout,
                            env=env,
                            timeout=args.timeout,
                        )
                        record["name"] = "release-provenance-verification"
                        record["commit_sha"] = resolved
                        record["release_run_id"] = run_id
                        lanes.append(record)
                        if int(record.get("exit_code") or 0) != 0:
                            raise RuntimeError(
                                "release provenance failed immediate cryptographic verification"
                            )
        if args.stage is not None:
            final_status = f"STAGE_{args.stage.upper()}_PASS"
            print(
                f"release-check: STAGE PASS [{args.stage}] {resolved} "
                "— partial evidence, not a release verdict",
                flush=True,
            )
        else:
            releasable_gate = (
                not args.skip_e2e and args.include_endurance and evidence_dir is not None
            )
            final_status = "PASS" if releasable_gate else "PARTIAL_PASS"
            if args.skip_e2e:
                print(
                    "release-check: PARTIAL PASS — e2e omitted, not releasable",
                    flush=True,
                )
            elif not args.include_endurance:
                print(
                    "release-check: PARTIAL PASS — endurance omitted, not releasable",
                    flush=True,
                )
            else:
                print(f"release-check: PASS {resolved}", flush=True)
        return 0
    except KeyboardInterrupt:
        error = "release check interrupted"
        final_status = "INTERRUPTED"
        print("release-check: interrupted; evidence remains unpublished", file=sys.stderr)
        return 130
    except (OSError, RuntimeError, subprocess.CalledProcessError) as exc:
        error = str(exc)
        print(f"release-check: FAIL {exc}", file=sys.stderr)
        return 1
    finally:
        if (
            evidence_dir is not None
            and evidence_stage is not None
            and final_status != "INTERRUPTED"
        ):
            result_record = {
                "commit_sha": resolved,
                "release_run_id": run_id,
                "release_policy": RELEASE_POLICY_VERSION,
                "status": final_status,
                "releasable": (
                    final_status == "PASS"
                    and evidence_dir is not None
                    and args.skip_e2e is False
                    and args.include_endurance is True
                ),
                "provenance_verification": (
                    json.loads(
                        (evidence_stage / "release-provenance-verification.json").read_text(
                            encoding="utf-8"
                        )
                    )
                    if (evidence_stage / "release-provenance-verification.json").is_file()
                    else None
                ),
                "error": error,
                "optional_integrations": {
                    "hermes_referee": {
                        "required_for_core_release": False,
                        "source_sha": resolved,
                        "commit_sha": resolved,
                        "release_run_id": run_id,
                        "status": (
                            "PASS"
                            if any(
                                item.get("name") == "hermes-live"
                                and int(item.get("exit_code") or 0) == 0
                                for item in lanes
                            )
                            else "FAIL"
                            if args.include_hermes_live
                            else "not_certified_live"
                        ),
                    }
                },
                "lanes": [_evidence_record(item) for item in lanes],
            }
            _write_json(evidence_stage / "final-release-result.json", result_record)
            if (
                final_status == "PASS"
                and result_record["releasable"] is True
                and release_env is not None
                and not args.defer_signing
            ):
                try:
                    _certify_evidence(
                        evidence_stage,
                        checkout=checkout,
                        env=release_env,
                        uv=args.uv,
                        source_sha=resolved,
                        release_run_id=run_id,
                        timeout=args.timeout,
                    )
                except (OSError, RuntimeError, subprocess.CalledProcessError) as exc:
                    error = f"certification root failed: {exc}"
                    certification_failure = error
                    final_status = "FAIL"
                    result_record["status"] = final_status
                    result_record["releasable"] = False
                    result_record["error"] = error
                    _write_json(evidence_stage / "final-release-result.json", result_record)
            evidence_dir.parent.mkdir(parents=True, exist_ok=True)
            if evidence_dir.exists():
                raise RuntimeError(f"release evidence target already exists: {evidence_dir}")
            os.replace(evidence_stage, evidence_dir)
            evidence_stage = None
        shutil.rmtree(temp_root, ignore_errors=True)
        if evidence_dir is not None:
            print(f"release-check: evidence published at {evidence_dir}", flush=True)
        if certification_failure is not None:
            raise SystemExit(1)


if __name__ == "__main__":
    raise SystemExit(main())
