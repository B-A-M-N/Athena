{
  "policy_version": "release-policy-v1",
  "mandatory_lanes": [
    "ruff-format",
    "ruff-check",
    "uv-lock-check",
    "mypy",
    "dependency-audit",
    "rust-supply-chain",
    "static-critical",
    "compileall",
    "architecture-lint",
    "support-matrix",
    "migration-baseline",
    "pytest",
    "functional-proof",
    "anthropic-sdk-compat",
    "remote-pack-security",
    "pytest-performance",
    "release-scenarios",
    "uv-version",
    "python-version",
    "cargo-version",
    "rustc-version",
    "toolchain-passport",
    "alacrity-benchmark",
    "indexing-benchmark",
    "rendering-benchmark",
    "backend-passport",
    "native-check",
    "native-test",
    "release-artifacts",
    "clean-install-upgrade-rollback",
    "native-smoke",
    "endurance",
    "e2e",
    "sandbox-matrix",
    "workflow-strategy",
    "mcp-stdio",
    "mcp-streamable-http",
    "native-input-smoke",
    "native-visual-smoke",
    "native-desktop-acceptance",
